{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "uc-apex",
  "permissions": [
    {
      "action": "shell",
      "resource": "git push *",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "git reset --hard *",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "rm -rf *",
      "effect": "ask"
    },
    {
      "action": "ultracode_playwright_*",
      "resource": "*",
      "effect": "deny"
    }
  ],
  "compaction": {
    "auto": true,
    "keep": {
      "tokens": 15000
    },
    "buffer": "15%"
  },
  "mcp": {
    "servers": {
      "ultracode_playwright": {
        "type": "local",
        "command": ["uc", "mcp"],
        "disabled": false,
        "codemode": false,
        "timeout": {
          "startup": 60000,
          "catalog": 30000,
          "execution": 600000
        }
      }
    }
  },
  "plugins": [
    "{env:HOME}/.local/share/ultracode/runtime/superpowers"
  ]
}
