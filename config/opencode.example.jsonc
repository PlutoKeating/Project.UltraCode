{
  "$schema": "https://opencode.ai/config.json",
  "model": "google-vertex/gemini-4-neon",
  "default_agent": "orchestrator",
  "agents": {
    "build": {
      "model": "google-vertex/gemini-4-neon#high"
    },
    "plan": {
      "model": "google-vertex/gemini-4-carbon#high"
    },
    "general": {
      "model": "google-vertex/gemini-4-neon#high"
    },
    "explore": {
      "model": "google-vertex/gemini-4-hydrogen#low"
    }
  },
  "permissions": [
    {
      "action": "shell",
      "resource": "git push *",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "git reset --hard *",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "rm -rf *",
      "effect": "ask"
    },
    {
      "action": "playwright_*",
      "resource": "*",
      "effect": "deny"
    }
  ],
  "providers": {
    "google-vertex": {
      "settings": {
        "project": "{env:GOOGLE_CLOUD_PROJECT}",
        "location": "global"
      }
    }
  },
  "compaction": {
    "auto": true,
    "keep": {
      "tokens": 15000
    },
    "buffer": "15%"
  },
  "mcp": {
    "servers": {
      "playwright": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "@playwright/mcp@0.0.86",
          "--browser",
          "chromium",
          "--headless",
          "--isolated",
          "--output-dir",
          ".opencode/ultracode/qa"
        ],
        "disabled": false,
        "codemode": false,
        "timeout": {
          "startup": 60000,
          "catalog": 30000,
          "execution": 600000
        }
      }
    }
  },
  "plugins": [
    "superpowers@git+https://github.com/obra/superpowers.git#v7.0.2"
  ]
}
