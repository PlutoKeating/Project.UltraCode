---
import "../styles/tokens.css";
import HeroShowcase from "./diagrams/HeroShowcase.astro";
import GoalComparisonDiagram from "./diagrams/GoalComparisonDiagram.astro";
import MinimalDemoDiagram from "./diagrams/MinimalDemoDiagram.astro";
import RolesTopologyDiagram from "./diagrams/RolesTopologyDiagram.astro";
import LongRunningDiagram from "./diagrams/LongRunningDiagram.astro";
import TuiControlsDiagram from "./diagrams/TuiControlsDiagram.astro";
import { LANDING_COPY, LOCALES, LOCALE_META, type Locale } from "../i18n/ui";

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const meta = LOCALE_META[lang];
const copy = LANDING_COPY[lang];

const siteOrigin = Astro.site?.origin ?? "https://ultracode.plutokeating.beer";
const canonicalUrl = new URL(meta.homePath, siteOrigin).href;
const ogImageUrl = new URL(meta.ogImagePath, siteOrigin).href;

const unixInstallCmd = "curl -fsSL https://ultracode.plutokeating.beer/install.sh | bash";
const winInstallCmd = "irm https://ultracode.plutokeating.beer/install.ps1 | iex";
const docsHref = meta.docsStartPath;

const jsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": `${siteOrigin}/#organization`,
      name: "UltraCode",
      url: `${siteOrigin}/`,
      logo: `${siteOrigin}/favicon.svg`,
      sameAs: ["https://github.com/PlutoKeating/Project.UltraCode"],
    },
    {
      "@type": "WebSite",
      "@id": `${siteOrigin}/#website`,
      url: `${siteOrigin}/`,
      name: "UltraCode",
      inLanguage: meta.htmlLang,
      publisher: { "@id": `${siteOrigin}/#organization` },
    },
    {
      "@type": "SoftwareApplication",
      "@id": `${siteOrigin}/#software`,
      name: "UltraCode",
      softwareVersion: "1.0.0",
      applicationCategory: "DeveloperApplication",
      operatingSystem: "macOS, Linux, Windows",
      description: copy.metaDescription,
      url: canonicalUrl,
      image: ogImageUrl,
      downloadUrl: "https://github.com/PlutoKeating/Project.UltraCode/releases/latest",
      license: "https://opensource.org/licenses/MIT",
      inLanguage: meta.htmlLang,
      author: { "@id": `${siteOrigin}/#organization` },
      offers: {
        "@type": "Offer",
        price: "0",
        priceCurrency: "USD",
      },
    },
  ],
}).replace(/</g, "\\u003c");
---

<!doctype html>
<html lang={meta.htmlLang} dir={meta.dir} data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{copy.metaTitle}</title>
    <meta name="description" content={copy.metaDescription} />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <link rel="canonical" href={canonicalUrl} />
    {
      LOCALES.map((code) => (
        <link
          rel="alternate"
          hreflang={LOCALE_META[code].hreflang}
          href={new URL(LOCALE_META[code].homePath, siteOrigin).href}
        />
      ))
    }
    <link rel="alternate" hreflang="x-default" href={new URL("/", siteOrigin).href} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="text/plain" href="/llms.txt" title="UltraCode LLM Documentation Index" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="UltraCode" />
    <meta property="og:title" content={copy.metaTitle} />
    <meta property="og:description" content={copy.metaDescription} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={copy.metaTitle} />
    <meta property="og:locale" content={meta.ogLocale} />
    {
      LOCALES.filter((code) => code !== lang).map((code) => (
        <meta property="og:locale:alternate" content={LOCALE_META[code].ogLocale} />
      ))
    }

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={copy.metaTitle} />
    <meta name="twitter:description" content={copy.metaDescription} />
    <meta name="twitter:image" content={ogImageUrl} />

    <script type="application/ld+json" set:html={jsonLd} />
  </head>
  <body>
    <div class="uc-optical-horizon" aria-hidden="true"></div>
    <div class="uc-grain" aria-hidden="true"></div>
    <div class="uc-page">
      <header class="uc-nav">
        <div class="uc-nav-inner">
          <a href={meta.homePath} class="uc-brand" aria-label="UltraCode" dir="ltr">
            <svg viewBox="0 0 240 300" fill="none" aria-hidden="true">
              <path d="M60 120H180V240H60V120Z" fill="#4B4B4B"/>
              <path d="M60 60H180V120H60V60Z" fill="#2A2A2A"/>
              <path d="M0 0H60V240H180V60H240V300H0V0Z" fill="#EEEEEE"/>
              <path d="M180 0H240V42H180V0Z" fill="#E5A03D"/>
            </svg>
            <span>UltraCode</span>
          </a>

          <nav class="uc-nav-links" aria-label={copy.navAria}>
            <a href={docsHref}>{copy.navDocs}</a>
            <a href="https://github.com/PlutoKeating/Project.UltraCode" target="_blank" rel="noreferrer" dir="ltr">GitHub</a>
            <details class="uc-lang-menu">
              <summary class="uc-lang-link" aria-label={copy.langMenuAria}>
                <span>{meta.shortLabel}</span>
                <svg viewBox="0 0 12 12" fill="none" aria-hidden="true">
                  <path d="M3 4.5L6 7.5L9 4.5" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </summary>
              <div class="uc-lang-popover" role="menu">
                {
                  LOCALES.map((code) => (
                    <a
                      href={LOCALE_META[code].homePath}
                      role="menuitem"
                      aria-current={code === lang ? "page" : undefined}
                      class:list={["uc-lang-option", { "is-current": code === lang }]}
                      dir={LOCALE_META[code].dir}
                    >
                      <span>{LOCALE_META[code].nativeLabel}</span>
                      <span class="uc-lang-code" dir="ltr">{LOCALE_META[code].shortLabel}</span>
                    </a>
                  ))
                }
              </div>
            </details>
          </nav>
        </div>
      </header>

      <main>
        <!-- Hero: Pure Pitch-Black Architecture + Fixed Anamorphic Optical Horizon -->
        <section class="uc-hero" data-lit>
          <div class="uc-container uc-hero-inner">
            <h1>{copy.heroTitle}</h1>
            <p class="uc-hero-sub">{copy.heroSub}</p>

            <div class="uc-install-stack" data-install-widget data-unix={unixInstallCmd} data-win={winInstallCmd}>
              <div class="uc-os-tabs" role="tablist" aria-label={copy.osTabsAria} dir="ltr">
                <button type="button" role="tab" aria-selected="true" class="uc-os-tab is-active" data-os="unix">
                  macOS / Linux
                </button>
                <button type="button" role="tab" aria-selected="false" class="uc-os-tab" data-os="win">
                  Windows
                </button>
              </div>

              <div class="uc-install-row">
                <div class="uc-install-bar" dir="ltr">
                  <code class="uc-install-code" data-install-code>{unixInstallCmd}</code>
                  <button
                    type="button"
                    class="uc-btn-white"
                    data-copy={unixInstallCmd}
                    data-install-copy
                    data-copied-label={copy.copied}
                    data-default-label={copy.copyInstall}
                  >
                    {copy.copyInstall}
                  </button>
                </div>
                <a href={docsHref} class="uc-quickstart-link">
                  <span>{copy.quickStart}</span>
                  <svg viewBox="0 0 16 16" fill="none" aria-hidden="true" class="uc-dir-arrow">
                    <path d="M3.5 8H12.5M9 4.5L12.5 8L9 11.5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </a>
              </div>

              <div class="uc-surfaces-line" aria-label={copy.surfacesAria} dir="ltr">
                <code>ultracode</code>
                <span aria-hidden="true">·</span>
                <code>ultracode desktop</code>
                <span aria-hidden="true">·</span>
                <code>ultracode pair</code>
              </div>

              <p class="uc-provenance-line">{copy.builtWithCredit}</p>
            </div>

            <div class="uc-hero-stage">
              <HeroShowcase lang={lang} />
            </div>
          </div>
        </section>

        <!-- Section 2: Open-Canvas Trajectory Comparison (Zero Outer Box) -->
        <section class="uc-section" data-lit>
          <div class="uc-container">
            <div class="uc-section-head">
              <h2>{copy.sec2Title}</h2>
              <p>{copy.sec2Sub}</p>
            </div>
            <div class="uc-open-canvas">
              <GoalComparisonDiagram lang={lang} />
            </div>
          </div>
        </section>

        <!-- Section 3: 4-Column Architectural Hairline Rail -->
        <section class="uc-section" data-lit>
          <div class="uc-container">
            <div class="uc-section-head">
              <h2>{copy.sec3Title}</h2>
              <p>{copy.sec3Sub}</p>
            </div>

            <div class="uc-open-canvas">
              <MinimalDemoDiagram lang={lang} />
            </div>

            <div class="uc-prompt-rail">
              <div class="uc-prompt-text">
                <span class="uc-prompt-mark" dir="ltr">&gt;</span>
                <span>{copy.examplePrompt}</span>
              </div>
              <button
                type="button"
                class="uc-btn-ghost"
                data-copy={copy.examplePrompt}
                data-copied-label={copy.copied}
                data-default-label={copy.copyPrompt}
              >
                {copy.copyPrompt}
              </button>
            </div>
          </div>
        </section>

        <!-- Section 4: Full-Width Roles & Experts -->
        <section class="uc-section" data-lit>
          <div class="uc-container">
            <div class="uc-section-head">
              <h2>{copy.sec4Title}</h2>
              <p>{copy.sec4Sub}</p>
            </div>
            <div class="uc-open-canvas">
              <RolesTopologyDiagram lang={lang} />
            </div>
          </div>
        </section>

        <!-- Section 5: Full-Width Long-Running Continuation -->
        <section class="uc-section" data-lit>
          <div class="uc-container">
            <div class="uc-section-head">
              <h2>{copy.sec5Title}</h2>
              <p>{copy.sec5Sub}</p>
            </div>
            <div class="uc-open-canvas">
              <LongRunningDiagram lang={lang} />
            </div>
          </div>
        </section>

        <!-- Section 6: Full-Width Live Controls Across Surfaces -->
        <section class="uc-section" data-lit>
          <div class="uc-container">
            <div class="uc-section-head">
              <h2>{copy.sec6Title}</h2>
              <p>{copy.sec6Sub}</p>
            </div>
            <div class="uc-open-canvas">
              <TuiControlsDiagram lang={lang} />
            </div>
          </div>
        </section>

        <!-- Section 7: Quiet Monumental Close -->
        <section class="uc-close" data-lit>
          <div class="uc-container uc-close-inner">
            <h2>{copy.closeTitle}</h2>
            <p class="uc-close-trust">{copy.closeTrust}</p>

            <div class="uc-install-stack" data-install-widget data-unix={unixInstallCmd} data-win={winInstallCmd}>
              <div class="uc-os-tabs" role="tablist" aria-label={copy.osTabsAria} dir="ltr">
                <button type="button" role="tab" aria-selected="true" class="uc-os-tab is-active" data-os="unix">
                  macOS / Linux
                </button>
                <button type="button" role="tab" aria-selected="false" class="uc-os-tab" data-os="win">
                  Windows
                </button>
              </div>

              <div class="uc-install-row">
                <div class="uc-install-bar" dir="ltr">
                  <code class="uc-install-code" data-install-code>{unixInstallCmd}</code>
                  <button
                    type="button"
                    class="uc-btn-white"
                    data-copy={unixInstallCmd}
                    data-install-copy
                    data-copied-label={copy.copied}
                    data-default-label={copy.copyInstall}
                  >
                    {copy.copyInstall}
                  </button>
                </div>
                <a href={docsHref} class="uc-btn-outline">
                  <span>{copy.openQuickStart}</span>
                  <svg viewBox="0 0 16 16" fill="none" aria-hidden="true" class="uc-dir-arrow">
                    <path d="M3.5 8H12.5M9 4.5L12.5 8L9 11.5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </a>
              </div>
            </div>
          </div>
        </section>
      </main>

      <footer class="uc-footer">
        <div class="uc-container uc-footer-inner">
          <span>{copy.footerLicense}</span>
          <div class="uc-footer-links">
            <a href={docsHref}>{copy.footerDocs}</a>
            <a href="https://github.com/PlutoKeating/Project.UltraCode" target="_blank" rel="noreferrer" dir="ltr">GitHub</a>
            <div class="uc-footer-langs" aria-label={copy.langMenuAria}>
              {
                LOCALES.map((code) => (
                  <a
                    href={LOCALE_META[code].homePath}
                    aria-current={code === lang ? "page" : undefined}
                    class:list={[{ "is-current": code === lang }]}
                    dir={LOCALE_META[code].dir}
                  >
                    {LOCALE_META[code].nativeLabel}
                  </a>
                ))
              }
            </div>
          </div>
        </div>
      </footer>
    </div>

    <script>
      const widgets = Array.from(document.querySelectorAll<HTMLElement>("[data-install-widget]"));
      const setInstallOs = (os: "unix" | "win") => {
        for (const widget of widgets) {
          const cmd = os === "win" ? widget.dataset.win ?? "" : widget.dataset.unix ?? "";
          const code = widget.querySelector<HTMLElement>("[data-install-code]");
          const copyBtn = widget.querySelector<HTMLButtonElement>("[data-install-copy]");
          if (code && cmd) code.textContent = cmd;
          if (copyBtn && cmd) copyBtn.dataset.copy = cmd;
          widget.querySelectorAll<HTMLButtonElement>("[data-os]").forEach((tab) => {
            const active = tab.dataset.os === os;
            tab.classList.toggle("is-active", active);
            tab.setAttribute("aria-selected", active ? "true" : "false");
          });
        }
      };

      widgets.forEach((widget) => {
        widget.querySelectorAll<HTMLButtonElement>("[data-os]").forEach((tab) => {
          tab.addEventListener("click", () => {
            setInstallOs(tab.dataset.os === "win" ? "win" : "unix");
          });
        });
      });

      if (/Win/i.test(navigator.userAgent)) {
        setInstallOs("win");
      }

      document.querySelectorAll<HTMLButtonElement>("[data-copy]").forEach((btn) => {
        btn.addEventListener("click", async () => {
          const text = btn.dataset.copy ?? "";
          if (!text) return;
          try {
            await navigator.clipboard.writeText(text);
            const copied = btn.dataset.copiedLabel || "Copied";
            const original = btn.dataset.defaultLabel || btn.textContent || "";
            btn.textContent = copied;
            btn.classList.add("is-copied");
            window.setTimeout(() => {
              btn.textContent = original;
              btn.classList.remove("is-copied");
            }, 1800);
          } catch {
            // Clipboard unavailable
          }
        });
      });

      document.addEventListener("click", (e) => {
        document.querySelectorAll<HTMLDetailsElement>("details.uc-lang-menu[open]").forEach((menu) => {
          if (!menu.contains(e.target as Node)) menu.removeAttribute("open");
        });
      });

      // Scroll-coupled optical response against the stationary 58vh horizon light
      const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      const litSections = Array.from(document.querySelectorAll<HTMLElement>("[data-lit]"));
      const heroStage = document.querySelector<HTMLElement>(".uc-hero-stage");
      if (!reduceMotion && litSections.length > 0) {
        let ticking = false;
        const updateOpticalField = () => {
          ticking = false;
          const vh = window.innerHeight || 900;
          const horizonY = vh * 0.58;
          for (const el of litSections) {
            const rect = el.getBoundingClientRect();
            const centerY = rect.top + rect.height * 0.45;
            const dist = Math.abs(centerY - horizonY);
            const lit = Math.max(0, Math.min(1, 1 - dist / (vh * 0.78)));
            el.style.setProperty("--uc-lit", lit.toFixed(3));
            const topProx = Math.max(0, Math.min(1, 1 - Math.abs(rect.top - horizonY) / (vh * 0.52)));
            el.style.setProperty("--uc-edge", topProx.toFixed(3));
          }
          if (heroStage) {
            const r = heroStage.getBoundingClientRect();
            const rimProx = Math.max(0, Math.min(1, 1 - Math.abs(r.top - horizonY) / (vh * 0.48)));
            heroStage.style.setProperty("--uc-rim", rimProx.toFixed(3));
          }
        };
        const onScroll = () => {
          if (!ticking) {
            ticking = true;
            window.requestAnimationFrame(updateOpticalField);
          }
        };
        updateOpticalField();
        window.addEventListener("scroll", onScroll, { passive: true });
        window.addEventListener("resize", onScroll, { passive: true });
      }
    </script>
  </body>
</html>

<style>
  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }

  html {
    font-size: 17.5px;
    color-scheme: dark;
  }

  ::selection {
    background: rgba(186, 230, 253, 0.24);
    color: #ffffff;
  }

  html,
  body {
    margin: 0;
    padding: 0;
    background: var(--uc-void);
    color: var(--uc-ink);
    font-family: var(--uc-font-sans);
    -webkit-font-smoothing: antialiased;
    font-variant-numeric: tabular-nums;
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  :focus-visible {
    outline: 1px solid var(--uc-ice);
    outline-offset: 3px;
  }

  /* Subtle cinema film grain (pure monochrome, zero color cast) */
  .uc-grain {
    position: fixed;
    inset: 0;
    z-index: 60;
    pointer-events: none;
    opacity: 0.024;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 180 180' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.85' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)'/%3E%3C/svg%3E");
  }

  .uc-page {
    position: relative;
    z-index: 1;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    overflow-x: clip;
    background: transparent;
  }

  .uc-container {
    width: 100%;
    max-width: 1180px;
    margin: 0 auto;
    padding: 0 2.25rem;
  }

  /* Header */
  .uc-nav {
    position: sticky;
    top: 0;
    z-index: 40;
    height: 74px;
    border-bottom: 1px solid var(--uc-hairline);
    background: rgba(0, 0, 0, 0.84);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
  }

  .uc-nav-inner {
    max-width: 1260px;
    height: 100%;
    margin: 0 auto;
    padding: 0 2.25rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .uc-brand {
    display: inline-flex;
    align-items: center;
    gap: 0.72rem;
    font-weight: 600;
    font-size: 1.28rem;
    letter-spacing: -0.025em;
    line-height: 1;
    color: #ffffff;
  }

  .uc-brand svg {
    height: 26px;
    width: auto;
  }

  .uc-nav-links {
    display: flex;
    align-items: center;
    gap: 2.25rem;
    font-size: 0.9rem;
    color: var(--uc-ink-secondary);
  }

  .uc-nav-links > a {
    transition: color 150ms ease;
  }

  .uc-nav-links > a:hover {
    color: #ffffff;
  }

  .uc-lang-menu {
    position: relative;
  }

  .uc-lang-menu summary {
    list-style: none;
  }

  .uc-lang-menu summary::-webkit-details-marker {
    display: none;
  }

  .uc-lang-link {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    cursor: pointer;
    user-select: none;
    font-family: var(--uc-font-mono);
    font-size: 0.78rem;
    padding: 0.25rem 0.6rem;
    border-radius: 4px;
    border: 1px solid rgba(255, 255, 255, 0.14);
    color: #d4d4d4;
    transition: border-color 150ms ease, color 150ms ease;
  }

  .uc-lang-link svg {
    width: 11px;
    height: 11px;
    opacity: 0.72;
  }

  .uc-lang-link:hover,
  .uc-lang-menu[open] .uc-lang-link {
    border-color: rgba(255, 255, 255, 0.38);
    color: #ffffff;
  }

  .uc-lang-popover {
    position: absolute;
    top: calc(100% + 0.5rem);
    inset-inline-end: 0;
    min-width: 158px;
    padding: 0.3rem;
    border-radius: 6px;
    border: 1px solid rgba(255, 255, 255, 0.14);
    background: #070707;
    box-shadow: 0 12px 28px rgba(0, 0, 0, 0.72);
    display: flex;
    flex-direction: column;
    gap: 0.12rem;
    z-index: 50;
  }

  .uc-lang-option {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.8rem;
    padding: 0.42rem 0.65rem;
    border-radius: 4px;
    font-size: 0.82rem;
    color: #b5b5b5;
    transition: background 120ms ease, color 120ms ease;
  }

  .uc-lang-option:hover {
    background: rgba(255, 255, 255, 0.06);
    color: #ffffff;
  }

  .uc-lang-option.is-current {
    background: rgba(255, 255, 255, 0.08);
    color: #ffffff;
  }

  .uc-lang-code {
    font-family: var(--uc-font-mono);
    font-size: 0.7rem;
    color: #737373;
  }

  /* Hero */
  .uc-hero {
    position: relative;
    min-height: calc(100svh - 74px);
    display: flex;
    align-items: center;
    padding: clamp(5rem, 9vh, 8.5rem) 0 clamp(3.5rem, 6vh, 5.5rem);
  }

  /* Viewport-fixed anamorphic optical horizon: stays stationary as foreground glides over it */
  .uc-optical-horizon {
    position: fixed;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    background:
      radial-gradient(48% 24% at 32% 58%, rgba(186, 230, 253, 0.14), transparent 72%),
      radial-gradient(42% 22% at 70% 58%, rgba(229, 160, 61, 0.11), transparent 74%);
  }

  .uc-hero-inner {
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  /* Sharp weight-500 architectural display type (no clunky 700 bold) */
  .uc-hero h1 {
    margin: 0;
    font-family: var(--uc-font-display);
    font-size: clamp(2.8rem, 5.2vw, 4.35rem);
    font-weight: 500;
    letter-spacing: -0.04em;
    line-height: 1.12;
    color: #ffffff;
    text-wrap: balance;
  }

  :global(html[lang="ar"]) .uc-hero h1,
