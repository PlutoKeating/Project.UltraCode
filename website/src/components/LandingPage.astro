---
import "../styles/tokens.css";
import HeroShowcase from "./diagrams/HeroShowcase.astro";
import GoalComparisonDiagram from "./diagrams/GoalComparisonDiagram.astro";
import MinimalDemoDiagram from "./diagrams/MinimalDemoDiagram.astro";
import RolesTopologyDiagram from "./diagrams/RolesTopologyDiagram.astro";
import LongRunningDiagram from "./diagrams/LongRunningDiagram.astro";
import TuiControlsDiagram from "./diagrams/TuiControlsDiagram.astro";

interface Props {
  lang: "zh" | "en";
}

const { lang } = Astro.props;
const zh = lang === "zh";

const installCmd = "curl -fsSL https://ultracode.plutokeating.beer/install.sh | bash";
const docsHref = zh ? "/docs/getting-started/" : "/en/docs/getting-started/";
const altHref = zh ? "/en/" : "/";
const altLabel = zh ? "EN" : "中文";
const examplePrompt = zh
  ? "帮我做一个个人作品集单页，克制暗色风格，桌面和手机都要好看，做完自己打开浏览器检查并修复所有排版问题。"
  : "Build a restrained dark portfolio page that looks sharp on desktop and mobile, then open a real browser to inspect and fix any layout issues.";
---

<!doctype html>
<html lang={zh ? "zh-CN" : "en"} data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{zh ? "UltraCode — 让 OpenCode 迈入目标工程时代" : "UltraCode — Goal Engineering for OpenCode"}</title>
    <meta
      name="description"
      content={zh
        ? "继 Prompt 与 Context 之后，为官方 OpenCode 带来目标工程（Goal Engineering）：先调研澄清、多角色协作、真机浏览器目视验收、持久交接续跑。"
        : "Goal Engineering for official OpenCode V2: clarify upfront, orchestrate specialized subagents, verify in a real browser, and hand off cleanly across long-running work."}
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body>
    <div class="uc-grain" aria-hidden="true"></div>
    <div class="uc-page">
      <header class="uc-nav">
        <div class="uc-nav-inner">
          <a href={zh ? "/" : "/en/"} class="uc-brand" aria-label="UltraCode">
            <svg viewBox="0 0 32 32" fill="none" aria-hidden="true">
              <path d="M16 2.5L28 9.25V22.75L16 29.5L4 22.75V9.25L16 2.5Z" stroke="#737373" stroke-width="1.2"/>
              <path d="M10.5 10.5V18.25L16 21.5L21.5 18.25V10.5" stroke="#FFFFFF" stroke-width="1.8" stroke-linecap="square" stroke-linejoin="miter"/>
              <path d="M16 14.5V21.5" stroke="#BAE6FD" stroke-width="1.8" stroke-linecap="square"/>
              <circle cx="16" cy="10.25" r="1.5" fill="#E5A03D"/>
            </svg>
            <span>UltraCode</span>
          </a>

          <nav class="uc-nav-links" aria-label={zh ? "主导航" : "Main navigation"}>
            <a href={docsHref}>{zh ? "文档" : "Docs"}</a>
            <a href="https://github.com/PlutoKeating/Project.UltraCode" target="_blank" rel="noreferrer">GitHub</a>
            <a href={altHref} class="uc-lang-link">{altLabel}</a>
          </nav>
        </div>
      </header>

      <main>
        <!-- Hero: Pure Pitch-Black Architecture + Anamorphic Ice/Amber Optical Horizon -->
        <section class="uc-hero">
          <div class="uc-optical-horizon" aria-hidden="true"></div>
          <div class="uc-container uc-hero-inner">
            <h1>{zh ? "一句目标，交付到底" : "One Goal. Delivered End-to-End."}</h1>
            <p class="uc-hero-sub">
              {zh
                ? "继 Prompt 与 Context 之后，为官方 OpenCode 带来目标工程（Goal Engineering）"
                : "Beyond Prompt and Context — Goal Engineering for official OpenCode V2."}
            </p>

            <div class="uc-install-row">
              <div class="uc-install-bar">
                <code class="uc-install-code">{installCmd}</code>
                <button
                  type="button"
                  class="uc-btn-white"
                  data-copy={installCmd}
                  data-copied-label={zh ? "已复制" : "Copied"}
                  data-default-label={zh ? "复制安装" : "Copy install"}
                >
                  {zh ? "复制安装" : "Copy install"}
                </button>
              </div>
              <a href={docsHref} class="uc-quickstart-link">
                <span>{zh ? "快速开始" : "Quick start"}</span>
                <svg viewBox="0 0 16 16" fill="none" aria-hidden="true">
                  <path d="M3.5 8H12.5M9 4.5L12.5 8L9 11.5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </a>
            </div>

            <div class="uc-hero-stage">
              <HeroShowcase lang={lang} />
            </div>
          </div>
        </section>

        <!-- Section 2: Open-Canvas Trajectory Comparison (Zero Outer Box) -->
        <section class="uc-section">
          <div class="uc-container">
            <div class="uc-section-head">
              <h2>{zh ? "为什么装完立刻觉得 OpenCode 变强了" : "Why OpenCode Feels Immediately Stronger"}</h2>
              <p>
                {zh
                  ? "普通对话边猜边写、越聊越偏；UltraCode 用可验证的目标闭环替代盲目试错。"
                  : "Ordinary chat guesses and drifts; UltraCode replaces trial-and-error with a verified goal loop."}
              </p>
            </div>
            <div class="uc-open-canvas">
              <GoalComparisonDiagram lang={lang} />
            </div>
          </div>
        </section>

        <!-- Section 3: 4-Column Architectural Hairline Rail -->
        <section class="uc-section">
          <div class="uc-container">
            <div class="uc-section-head">
              <h2>{zh ? "装完立刻试：1 分钟最小上手体验" : "Try It Immediately: 1-Minute Demo"}</h2>
              <p>
                {zh
                  ? "在任意空目录运行 opencode，直接发下面这一句话，亲眼见证完整目标工程。"
                  : "Run opencode in any empty folder, send this single sentence, and watch Goal Engineering work."}
              </p>
            </div>

            <div class="uc-open-canvas">
              <MinimalDemoDiagram lang={lang} />
            </div>

            <div class="uc-prompt-rail">
              <div class="uc-prompt-text">
                <span class="uc-prompt-mark">&gt;</span>
                <span>{examplePrompt}</span>
              </div>
              <button
                type="button"
                class="uc-btn-ghost"
                data-copy={examplePrompt}
                data-copied-label={zh ? "已复制" : "Copied"}
                data-default-label={zh ? "复制示例" : "Copy prompt"}
              >
                {zh ? "复制示例" : "Copy prompt"}
              </button>
            </div>
          </div>
        </section>

        <!-- Section 4: Asymmetric Editorial Split — Roles & Experts -->
        <section class="uc-section">
          <div class="uc-container uc-split-grid">
            <div class="uc-split-copy">
              <h2>{zh ? "双主角色与 5 位后台专家" : "Two Primary Roles. Five Background Experts."}</h2>
              <p>
                {zh
                  ? "平时只需和 UltraBuild 自然对话；想先讨论方案、绝不误改代码时，按 Shift+Tab 切到 UltraPlan。"
                  : "Talk naturally to UltraBuild for end-to-end delivery, or press Shift+Tab for read-only UltraPlan."}
              </p>
              <div class="uc-key-legend">
                <div>
                  <span class="uc-key-cap">UltraBuild</span>
                  <span>{zh ? "默认总控 · 协调、实施、验收" : "Default · orchestrate & verify"}</span>
                </div>
                <div>
                  <span class="uc-key-cap">UltraPlan</span>
                  <span>{zh ? "Shift+Tab 切换 · 只读规划" : "Shift+Tab · read-only planning"}</span>
                </div>
              </div>
            </div>
            <div class="uc-split-visual">
              <RolesTopologyDiagram lang={lang} />
            </div>
          </div>
        </section>

        <!-- Section 5: Architectural 2-Column Hairline Split — Long-running & TUI Controls -->
        <section class="uc-section">
          <div class="uc-container">
            <div class="uc-dual-band">
              <div class="uc-dual-col">
                <div class="uc-section-head uc-head-compact">
                  <h2>{zh ? "长程任务不掉链子" : "Built for Multi-Hour Goals"}</h2>
                  <p>
                    {zh
                      ? "自动推进下一里程碑，随时响应插话与叫停；换天回来一句“读取交接并继续”即可无缝接力。"
                      : "Advances milestones automatically, yields when you steer, and resumes cleanly after restarts."}
                  </p>
                </div>
                <LongRunningDiagram lang={lang} />
              </div>

              <div class="uc-dual-col">
                <div class="uc-section-head uc-head-compact">
                  <h2>{zh ? "TUI 命令面板一键掌控" : "Live Control Inside the TUI"}</h2>
                  <p>
                    {zh
                      ? "在 OpenCode 命令面板搜索 UltraCode，独立切换「命令审批」与「方向询问」，安全边界始终受控。"
                      : "Search UltraCode in the TUI Command Palette to toggle Command approvals and Direction questions independently."}
                  </p>
                </div>
                <TuiControlsDiagram lang={lang} />
              </div>
            </div>
          </div>
        </section>

        <!-- Section 6: Quiet Monumental Close -->
        <section class="uc-close">
          <div class="uc-close-blade" aria-hidden="true"></div>
          <div class="uc-container uc-close-inner">
            <h2>{zh ? "一行命令装好，继续用你自己的模型" : "Install in One Line. Keep Your Models."}</h2>
            <p class="uc-close-trust">
              {zh
                ? "不改 OpenCode 官方二进制 · 不碰你的 API 密钥 · 不覆盖已有配置 · 随时可无痕卸载"
                : "Never modifies official OpenCode · Never touches API keys · Preserves your config · Clean uninstall"}
            </p>

            <div class="uc-install-row">
              <div class="uc-install-bar">
                <code class="uc-install-code">{installCmd}</code>
                <button
                  type="button"
                  class="uc-btn-white"
                  data-copy={installCmd}
                  data-copied-label={zh ? "已复制" : "Copied"}
                  data-default-label={zh ? "复制安装" : "Copy install"}
                >
                  {zh ? "复制安装" : "Copy install"}
                </button>
              </div>
              <a href={docsHref} class="uc-btn-outline">
                <span>{zh ? "进入 1 分钟快速开始" : "Open 1-Minute Quick Start"}</span>
                <svg viewBox="0 0 16 16" fill="none" aria-hidden="true">
                  <path d="M3.5 8H12.5M9 4.5L12.5 8L9 11.5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </a>
            </div>
          </div>
        </section>
      </main>

      <footer class="uc-footer">
        <div class="uc-container uc-footer-inner">
          <span>UltraCode · MIT License</span>
          <div class="uc-footer-links">
            <a href={docsHref}>{zh ? "文档教程" : "Documentation"}</a>
            <a href="https://github.com/PlutoKeating/Project.UltraCode" target="_blank" rel="noreferrer">GitHub</a>
            <a href={altHref}>{zh ? "English" : "简体中文"}</a>
          </div>
        </div>
      </footer>
    </div>

    <script>
      document.querySelectorAll<HTMLButtonElement>("[data-copy]").forEach((btn) => {
        btn.addEventListener("click", async () => {
          const text = btn.dataset.copy ?? "";
          if (!text) return;
          try {
            await navigator.clipboard.writeText(text);
            const copied = btn.dataset.copiedLabel || "Copied";
            const original = btn.dataset.defaultLabel || btn.textContent || "";
            btn.textContent = copied;
            btn.classList.add("is-copied");
            window.setTimeout(() => {
              btn.textContent = original;
              btn.classList.remove("is-copied");
            }, 1800);
          } catch {
            // Clipboard unavailable
          }
        });
      });
    </script>
  </body>
</html>

<style>
  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }

  html,
  body {
    margin: 0;
    padding: 0;
    background: var(--uc-void);
    color: var(--uc-ink);
    font-family: var(--uc-font-sans);
    -webkit-font-smoothing: antialiased;
    font-variant-numeric: tabular-nums;
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  /* Subtle cinema film grain (pure monochrome, zero color cast) */
  .uc-grain {
    position: fixed;
    inset: 0;
    z-index: 60;
    pointer-events: none;
    opacity: 0.024;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 180 180' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.85' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)'/%3E%3C/svg%3E");
  }

  .uc-page {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    overflow-x: clip;
  }

  .uc-container {
    width: 100%;
    max-width: 1140px;
    margin: 0 auto;
    padding: 0 2.25rem;
  }

  /* Header */
  .uc-nav {
    position: sticky;
    top: 0;
    z-index: 40;
    height: 70px;
    border-bottom: 1px solid var(--uc-hairline);
    background: rgba(0, 0, 0, 0.84);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
  }

  .uc-nav-inner {
    max-width: 1220px;
    height: 100%;
    margin: 0 auto;
    padding: 0 2.25rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .uc-brand {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    font-weight: 500;
    font-size: 1rem;
    letter-spacing: -0.015em;
    color: #ffffff;
  }

  .uc-brand svg {
    width: 24px;
    height: 24px;
  }

  .uc-nav-links {
    display: flex;
    align-items: center;
    gap: 2.25rem;
    font-size: 0.9rem;
    color: var(--uc-ink-secondary);
  }

  .uc-nav-links a {
    transition: color 150ms ease;
  }

  .uc-nav-links a:hover {
    color: #ffffff;
  }

  .uc-lang-link {
    font-family: var(--uc-font-mono);
    font-size: 0.78rem;
    padding: 0.25rem 0.6rem;
    border-radius: 4px;
    border: 1px solid rgba(255, 255, 255, 0.14);
    color: #d4d4d4;
  }

  .uc-lang-link:hover {
    border-color: rgba(255, 255, 255, 0.38);
    color: #ffffff;
  }

  /* Hero */
  .uc-hero {
    position: relative;
    padding: 6.5rem 0 4.5rem;
    isolation: isolate;
  }

  /* Anamorphic optical horizon: ice-cyan left bloom + warm tungsten amber right bloom */
  .uc-optical-horizon {
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    background:
      radial-gradient(48% 24% at 32% 54%, rgba(186, 230, 253, 0.14), transparent 72%),
      radial-gradient(42% 22% at 70% 54%, rgba(229, 160, 61, 0.11), transparent 74%);
  }

  .uc-hero-inner {
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  /* Sharp weight-500 architectural display type (no clunky 700 bold) */
  .uc-hero h1 {
    margin: 0;
    font-family: var(--uc-font-display);
    font-size: clamp(2.8rem, 5.2vw, 4.35rem);
    font-weight: 500;
    letter-spacing: -0.045em;
    line-height: 1.12;
    color: #ffffff;
    text-wrap: balance;
  }

  .uc-hero-sub {
    margin: 1.5rem 0 0;
    max-width: 660px;
    font-size: clamp(1.04rem, 1.5vw, 1.18rem);
    font-weight: 400;
    line-height: 1.72;
    color: var(--uc-ink-secondary);
    text-wrap: balance;
  }

  /* Precision monochrome install rail */
  .uc-install-row {
    margin-top: 2.8rem;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 1.25rem;
    width: 100%;
  }

  .uc-install-bar {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 0.4rem 0.42rem 0.4rem 1.25rem;
    border-radius: 8px;
    border: 1px solid rgba(255, 255, 255, 0.14);
    background: rgba(8, 8, 8, 0.9);
    max-width: 100%;
  }

  .uc-install-code {
    font-family: var(--uc-font-mono);
    font-size: 0.86rem;
    color: #d4d4d4;
    white-space: nowrap;
    overflow-x: auto;
    scrollbar-width: none;
  }

  .uc-install-code::-webkit-scrollbar {
    display: none;
  }

  /* Flagship pure white primary action button */
  .uc-btn-white {
    flex-shrink: 0;
    cursor: pointer;
    border: none;
    background: #ffffff;
    color: #000000;
    font-family: var(--uc-font-sans);
    font-size: 0.84rem;
    font-weight: 500;
    padding: 0.56rem 1.1rem;
    border-radius: 5px;
    transition: opacity 150ms ease, transform 150ms ease;
  }

  .uc-btn-white:hover {
    opacity: 0.88;
  }

  .uc-btn-white.is-copied {
    background: #bae6fd;
    color: #000000;
  }

  .uc-btn-ghost,
  .uc-btn-outline {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    flex-shrink: 0;
    cursor: pointer;
    border: 1px solid rgba(255, 255, 255, 0.18);
    background: transparent;
    color: #ffffff;
    font-family: var(--uc-font-sans);
    font-size: 0.86rem;
    font-weight: 500;
    padding: 0.62rem 1.15rem;
    border-radius: 6px;
    transition: border-color 150ms ease, background 150ms ease;
  }

  .uc-btn-ghost:hover,
  .uc-btn-outline:hover {
    border-color: rgba(255, 255, 255, 0.42);
    background: rgba(255, 255, 255, 0.05);
  }

  .uc-btn-ghost.is-copied {
    border-color: #bae6fd;
    color: #bae6fd;
  }

  .uc-quickstart-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.92rem;
    font-weight: 400;
    color: #b5b5b5;
    padding: 0.55rem 0.75rem;
    transition: color 150ms ease;
  }

  .uc-quickstart-link:hover {
    color: #ffffff;
  }

  .uc-quickstart-link svg,
  .uc-btn-outline svg {
    width: 15px;
    height: 15px;
  }

  .uc-hero-stage {
    width: 100%;
    margin-top: 4.25rem;
  }

  /* Architectural Hairline Sections — generous 140px+ visual breathing room */
  .uc-section {
    padding: 7.5rem 0;
    border-top: 1px solid var(--uc-hairline);
  }

  .uc-section-head {
    max-width: 680px;
    margin-bottom: 3.25rem;
  }

  .uc-head-compact {
    margin-bottom: 2.25rem;
  }

  .uc-section-head h2,
  .uc-split-copy h2 {
    margin: 0;
    font-family: var(--uc-font-display);
    font-size: clamp(1.75rem, 2.9vw, 2.35rem);
    font-weight: 500;
    letter-spacing: -0.035em;
    line-height: 1.24;
    color: #ffffff;
  }

  .uc-section-head p,
  .uc-split-copy p {
    margin: 1rem 0 0;
    font-size: 1rem;
    line-height: 1.78;
    color: var(--uc-ink-secondary);
  }

  .uc-open-canvas {
    width: 100%;
  }

  /* Hairline prompt rail */
  .uc-prompt-rail {
    margin-top: 2.25rem;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1.25rem;
    padding: 1.15rem 0;
    border-top: 1px solid var(--uc-hairline);
    border-bottom: 1px solid var(--uc-hairline);
  }

  .uc-prompt-text {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    font-size: 0.94rem;
    line-height: 1.65;
    color: #d4d4d4;
    flex: 1;
    min-width: 240px;
  }

  .uc-prompt-mark {
    font-family: var(--uc-font-mono);
    color: var(--uc-amber);
  }

  /* Asymmetric 38/62 Split */
  .uc-split-grid {
    display: grid;
    grid-template-columns: 0.82fr 1.18fr;
    gap: 4rem;
    align-items: center;
  }

  .uc-key-legend {
    margin-top: 2.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
    border-top: 1px solid var(--uc-hairline);
    padding-top: 1.5rem;
  }

  .uc-key-legend > div {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    font-size: 0.88rem;
    color: var(--uc-ink-secondary);
  }

  .uc-key-cap {
    font-family: var(--uc-font-mono);
    font-size: 0.78rem;
    color: #ffffff;
    border: 1px solid rgba(255, 255, 255, 0.16);
    padding: 0.22rem 0.55rem;
    border-radius: 4px;
    min-width: 96px;
    text-align: center;
  }

  /* Architectural 2-Column Dual Band */
  .uc-dual-band {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0;
    border-top: 1px solid var(--uc-hairline);
    border-bottom: 1px solid var(--uc-hairline);
  }

  .uc-dual-col {
    padding: 3rem 3rem 3rem 0;
  }

  .uc-dual-col + .uc-dual-col {
    padding: 3rem 0 3rem 3rem;
    border-left: 1px solid var(--uc-hairline);
  }

  /* Quiet Monumental Close */
  .uc-close {
    position: relative;
    padding: 8.5rem 0 7.5rem;
    border-top: 1px solid var(--uc-hairline);
    isolation: isolate;
  }

  .uc-close-blade {
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    background:
      radial-gradient(45% 55% at 44% 100%, rgba(186, 230, 253, 0.1), transparent 72%),
      radial-gradient(38% 48% at 62% 100%, rgba(229, 160, 61, 0.08), transparent 72%);
  }

  .uc-close-inner {
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .uc-close h2 {
    margin: 0;
    font-family: var(--uc-font-display);
    font-size: clamp(1.9rem, 3.4vw, 2.7rem);
