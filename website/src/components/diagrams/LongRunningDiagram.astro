---
interface Props {
  lang?: "zh" | "en";
}
const { lang = "zh" } = Astro.props;
const zh = lang === "zh";
---

<svg viewBox="0 0 920 248" fill="none" xmlns="http://www.w3.org/2000/svg" class="uc-svg-diagram" role="img" aria-label={zh ? "长程任务自动推进、随时插话与重启续跑流程图" : "Long-running milestone continuation, steering, and resumption flow"}>
  <rect x="0.5" y="0.5" width="919" height="247" rx="10" fill="#0A0A0A" stroke="rgba(255,255,255,0.09)"/>

  <!-- Main milestone line -->
  <line x1="88" y1="92" x2="832" y2="92" stroke="rgba(34,211,238,0.38)" stroke-width="2"/>

  <!-- Node 1 -->
  <circle cx="104" cy="92" r="10" fill="#050505" stroke="#22D3EE" stroke-width="2.2"/>
  <text x="104" y="64" text-anchor="middle" fill="#F5F5F5" font-family="Sora, PingFang SC, sans-serif" font-size="13" font-weight="600">
    {zh ? "里程碑 1 完成" : "Milestone 1 Done"}
  </text>
  <text x="104" y="126" text-anchor="middle" fill="#A3A3A3" font-family="Sora, PingFang SC, sans-serif" font-size="11.5">
    {zh ? "自动记录下一目标" : "Arms next milestone"}
  </text>

  <!-- Node 2 -->
  <circle cx="340" cy="92" r="10" fill="#050505" stroke="#22D3EE" stroke-width="2.2"/>
  <text x="340" y="64" text-anchor="middle" fill="#F5F5F5" font-family="Sora, PingFang SC, sans-serif" font-size="13" font-weight="600">
    {zh ? "自动续跑下一阶段" : "Auto-Continues"}
  </text>
  <text x="340" y="126" text-anchor="middle" fill="#A3A3A3" font-family="Sora, PingFang SC, sans-serif" font-size="11.5">
    {zh ? "无需反复催促“继续”" : "No manual nudging"}
  </text>

  <!-- Node 3: Steering branch -->
  <circle cx="580" cy="92" r="10" fill="#050505" stroke="#22D3EE" stroke-width="2.2"/>
  <text x="580" y="64" text-anchor="middle" fill="#F5F5F5" font-family="Sora, PingFang SC, sans-serif" font-size="13" font-weight="600">
    {zh ? "持久交接落盘" : "Handoff Saved"}
  </text>
  <text x="580" y="126" text-anchor="middle" fill="#A3A3A3" font-family="Sora, PingFang SC, sans-serif" font-size="11.5">
    {zh ? "任务与进度存入仓库" : "Tasks & progress stored"}
  </text>

  <!-- Node 4 -->
  <circle cx="816" cy="92" r="11" fill="#34D399"/>
  <path d="M 811.5 92 L 814.8 95.3 L 821 88.5" stroke="#050505" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
  <text x="816" y="64" text-anchor="middle" fill="#34D399" font-family="Sora, PingFang SC, sans-serif" font-size="13" font-weight="600">
    {zh ? "目标闭环交付" : "Goal Delivered"}
  </text>
  <text x="816" y="126" text-anchor="middle" fill="#A3A3A3" font-family="Sora, PingFang SC, sans-serif" font-size="11.5">
    {zh ? "验证通过再汇报" : "Verified before done"}
  </text>

  <!-- Bottom 2 Callout strips -->
  <rect x="36" y="160" width="408" height="58" rx="7" fill="#111111" stroke="rgba(255,255,255,0.09)"/>
  <text x="56" y="185" fill="#F5F5F5" font-family="Sora, PingFang SC, sans-serif" font-size="13" font-weight="600">
    {zh ? "随时插话或叫停，立即响应" : "Steer or stop anytime"}
  </text>
  <text x="56" y="205" fill="#A3A3A3" font-family="Sora, PingFang SC, sans-serif" font-size="12">
    {zh ? "你发出的任何新消息都会立刻接管节奏，不会失控乱跑" : "Any new message overrides the queued step immediately"}
  </text>

  <rect x="476" y="160" width="408" height="58" rx="7" fill="rgba(34,211,238,0.06)" stroke="rgba(34,211,238,0.28)"/>
  <text x="496" y="185" fill="#22D3EE" font-family="Sora, PingFang SC, sans-serif" font-size="13" font-weight="600">
    {zh ? "重启电脑或换天回来，无缝接力" : "Restart tomorrow, pick up cleanly"}
  </text>
  <text x="496" y="205" fill="#E0E0E0" font-family="Sora, PingFang SC, sans-serif" font-size="12">
    {zh ? "直接说“读取交接并继续”，立刻接着上次进度往下做" : "Just say \"read the handoff and continue\" to resume"}
  </text>
</svg>

<style>
  .uc-svg-diagram {
    width: 100%;
    height: auto;
    display: block;
  }
</style>
