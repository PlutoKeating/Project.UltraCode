---
interface Props {
  lang?: "zh" | "en";
}
const { lang = "zh" } = Astro.props;
const zh = lang === "zh";
---

<svg viewBox="0 0 520 220" fill="none" xmlns="http://www.w3.org/2000/svg" class="uc-svg-diagram" role="img" aria-label={zh ? "长程任务自动推进、随时插话与重启续跑流程图" : "Long-running milestone continuation, steering, and resumption flow"}>
  <!-- Main optical rail -->
  <line x1="20" y1="68" x2="500" y2="68" stroke="rgba(255,255,255,0.16)" stroke-width="1.2"/>
  <line x1="20" y1="68" x2="364" y2="68" stroke="#FFFFFF" stroke-width="1.6"/>

  <!-- 4 milestone ticks -->
  <circle cx="32" cy="68" r="4.5" fill="#000000" stroke="#FFFFFF" stroke-width="1.6"/>
  <text x="32" y="42" fill="#D4D4D4" font-family="Sora, PingFang SC, sans-serif" font-size="12">{zh ? "里程碑 1" : "Milestone 1"}</text>
  <text x="32" y="96" fill="#666666" font-family="Sora, PingFang SC, sans-serif" font-size="11">{zh ? "自动记下一目标" : "Arms next step"}</text>

  <circle cx="196" cy="68" r="4.5" fill="#000000" stroke="#FFFFFF" stroke-width="1.6"/>
  <text x="196" y="42" text-anchor="middle" fill="#D4D4D4" font-family="Sora, PingFang SC, sans-serif" font-size="12">{zh ? "自动续跑" : "Auto-continue"}</text>
  <text x="196" y="96" text-anchor="middle" fill="#666666" font-family="Sora, PingFang SC, sans-serif" font-size="11">{zh ? "无需手动催促" : "Zero nudging"}</text>

  <circle cx="364" cy="68" r="4.5" fill="#E5A03D"/>
  <text x="364" y="42" text-anchor="middle" fill="#E5A03D" font-family="Sora, PingFang SC, sans-serif" font-size="12">{zh ? "交接落盘" : "Handoff saved"}</text>
  <text x="364" y="96" text-anchor="middle" fill="#737373" font-family="Sora, PingFang SC, sans-serif" font-size="11">{zh ? "进度存入仓库" : "Stored in repo"}</text>

  <circle cx="488" cy="68" r="5.5" fill="#BAE6FD"/>
  <text x="488" y="42" text-anchor="end" fill="#BAE6FD" font-family="Sora, PingFang SC, sans-serif" font-size="12" font-weight="500">{zh ? "闭环交付" : "Delivered"}</text>
  <text x="488" y="96" text-anchor="end" fill="#737373" font-family="Sora, PingFang SC, sans-serif" font-size="11">{zh ? "验收通过" : "Verified"}</text>

  <!-- Two clean hairline callout lines -->
  <line x1="0" y1="132" x2="520" y2="132" stroke="rgba(255,255,255,0.07)"/>
  <circle cx="8" cy="158" r="2.5" fill="#E5A03D"/>
  <text x="22" y="162" fill="#D4D4D4" font-family="Sora, PingFang SC, sans-serif" font-size="12.5" font-weight="500">{zh ? "随时插话或叫停：" : "Steer anytime:"}</text>
  <text x="140" y="162" fill="#8A8A8A" font-family="Sora, PingFang SC, sans-serif" font-size="12">{zh ? "新消息立即接管节奏，绝不失控" : "Any prompt overrides immediately"}</text>

  <circle cx="8" cy="192" r="2.5" fill="#BAE6FD"/>
  <text x="22" y="196" fill="#D4D4D4" font-family="Sora, PingFang SC, sans-serif" font-size="12.5" font-weight="500">{zh ? "重启无缝接力：" : "Resume cleanly:"}</text>
  <text x="140" y="196" fill="#8A8A8A" font-family="Sora, PingFang SC, sans-serif" font-size="12">{zh ? "一句“读取交接并继续”立刻续跑" : "Say \"read handoff and continue\""}</text>
</svg>

<style>
  .uc-svg-diagram {
    width: 100%;
    height: auto;
    display: block;
  }
</style>
