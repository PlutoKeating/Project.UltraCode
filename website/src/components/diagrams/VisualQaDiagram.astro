---
interface Props {
  lang?: "zh" | "en";
}
const { lang = "zh" } = Astro.props;
const zh = lang === "zh";
---

<div class="uc-vqa" role="group" aria-label={zh ? "真机浏览器目视验收闭环" : "Real-browser visual QA verification loop"}>
  <div class="uc-vqa-grid">
    <div class="uc-vqa-step">
      <span class="uc-num">01</span>
      <h3>{zh ? "启动真实页面" : "Launch Real App"}</h3>
      <p>{zh ? "打开真实 Chromium，覆盖桌面与手机视口。" : "Opens real Chromium at desktop & mobile sizes."}</p>
    </div>
    <div class="uc-vqa-step">
      <span class="uc-num is-ice">02</span>
      <h3>{zh ? "实操并目视检查" : "Click & Inspect"}</h3>
      <p>{zh ? "真实点击交互与表单，逐张检视排版与对比度。" : "Operates real controls and inspects layout & contrast."}</p>
    </div>
    <div class="uc-vqa-step">
      <span class="uc-num is-amber">03</span>
      <h3 class="is-amber">{zh ? "发现瑕疵即打回" : "Reject & Fix"}</h3>
      <p>{zh ? "发现遮挡、错位或低对比度，自动退回修复后重测。" : "Flags overlap, clipping, or contrast and loops back."}</p>
    </div>
    <div class="uc-vqa-step is-accent">
      <span class="uc-num is-ice">04</span>
      <h3 class="is-ice">{zh ? "眼见为实交付" : "Verified Ship"}</h3>
      <p>{zh ? "杜绝“测试通过但界面崩坏”的半成品交付。" : "No more \"tests pass but UI is broken\"."}</p>
    </div>
  </div>
  <div class="uc-vqa-loop">
    <span class="uc-loop-dot" aria-hidden="true"></span>
    <span>{zh ? "发现瑕疵自动回到第 02 步重测，独立视觉角色绝不放水" : "Defects loop back to step 02 — independent visual QA never rubber-stamps"}</span>
  </div>
</div>

<style>
  .uc-vqa {
    text-align: left;
  }

  .uc-vqa-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
  }

  .uc-vqa-step {
    padding: 1.5rem 1.25rem;
    border-right: 1px solid rgba(255, 255, 255, 0.08);
  }

  .uc-vqa-step:last-child {
    border-right: none;
  }

  .uc-vqa-step.is-accent {
    border-top: 1.5px solid #bae6fd;
    margin-top: -1px;
  }

  .uc-num {
    display: block;
    font-family: var(--uc-font-mono);
    font-size: 0.82rem;
    color: #8a8a8a;
    margin-bottom: 0.65rem;
  }

  .is-amber {
    color: #e5a03d !important;
  }

  .is-ice {
    color: #bae6fd !important;
  }

  .uc-vqa-step h3 {
    margin: 0 0 0.6rem !important;
    font-size: 1.05rem !important;
    font-weight: 500 !important;
    color: #ffffff;
    line-height: 1.35 !important;
  }

  .uc-vqa-step p {
    margin: 0 !important;
    font-size: 0.9rem !important;
    line-height: 1.65 !important;
    color: #b5b5b5 !important;
  }

  .uc-vqa-loop {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    padding-top: 1rem;
    font-size: 0.88rem;
    color: #a3a3a3;
  }

  .uc-loop-dot {
    width: 6px;
    height: 6px;
    border-radius: 999px;
    background: #e5a03d;
    flex-shrink: 0;
  }

  @media (max-width: 820px) {
    .uc-vqa-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .uc-vqa-step:nth-child(2n) {
      border-right: none;
    }

    .uc-vqa-step:nth-child(-n + 2) {
      border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    }
  }

  @media (max-width: 540px) {
    .uc-vqa-grid {
      grid-template-columns: 1fr;
    }

    .uc-vqa-step {
      border-right: none;
      border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    }

    .uc-vqa-step:last-child {
      border-bottom: none;
    }
  }
</style>
