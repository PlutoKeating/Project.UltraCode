---
import { DIAGRAMS_COPY, type Locale } from "../../i18n/ui";

interface Props {
  lang?: Locale;
}
const { lang = "en" } = Astro.props;
const t = DIAGRAMS_COPY[lang].vqa;
---

<div class="uc-vqa" role="group" aria-label={t.aria}>
  <div class="uc-vqa-grid">
    <div class="uc-vqa-step">
      <span class="uc-num">01</span>
      <h3>{t.s1Title}</h3>
      <p>{t.s1Sub}</p>
    </div>
    <div class="uc-vqa-step">
      <span class="uc-num is-ice">02</span>
      <h3>{t.s2Title}</h3>
      <p>{t.s2Sub}</p>
    </div>
    <div class="uc-vqa-step">
      <span class="uc-num is-amber">03</span>
      <h3 class="is-amber">{t.s3Title}</h3>
      <p>{t.s3Sub}</p>
    </div>
    <div class="uc-vqa-step is-accent">
      <span class="uc-num is-ice">04</span>
      <h3 class="is-ice">{t.s4Title}</h3>
      <p>{t.s4Sub}</p>
    </div>
  </div>
  <div class="uc-vqa-loop">
    <span class="uc-loop-dot" aria-hidden="true"></span>
    <span>{t.loopNote}</span>
  </div>
</div>

<style>
  .uc-vqa {
    text-align: start;
  }

  .uc-vqa-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
  }

  .uc-vqa-step {
    padding: 1.5rem 1.25rem;
    border-inline-end: 1px solid rgba(255, 255, 255, 0.08);
  }

  .uc-vqa-step:last-child {
    border-inline-end: none;
  }

  .uc-vqa-step.is-accent {
    border-top: 1.5px solid #bae6fd;
    margin-top: -1px;
  }

  .uc-num {
    display: block;
    font-family: var(--uc-font-mono);
    font-size: 0.82rem;
    color: #8a8a8a;
    margin-bottom: 0.65rem;
  }

  .is-amber {
    color: #e5a03d !important;
  }

  .is-ice {
    color: #bae6fd !important;
  }

  .uc-vqa-step h3 {
    margin: 0 0 0.6rem !important;
    font-size: 1.05rem !important;
    font-weight: 500 !important;
    color: #ffffff;
    line-height: 1.35 !important;
  }

  .uc-vqa-step p {
    margin: 0 !important;
    font-size: 0.9rem !important;
    line-height: 1.65 !important;
    color: #b5b5b5 !important;
  }

  .uc-vqa-loop {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    padding-top: 1rem;
    font-size: 0.88rem;
    color: #a3a3a3;
  }

  .uc-loop-dot {
    width: 6px;
    height: 6px;
    border-radius: 999px;
    background: #e5a03d;
    flex-shrink: 0;
  }

  @media (max-width: 820px) {
    .uc-vqa-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .uc-vqa-step:nth-child(2n) {
      border-inline-end: none;
    }

    .uc-vqa-step:nth-child(-n + 2) {
      border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    }
  }

  @media (max-width: 540px) {
    .uc-vqa-grid {
      grid-template-columns: 1fr;
    }

    .uc-vqa-step {
      border-inline-end: none;
      border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    }

    .uc-vqa-step:last-child {
      border-bottom: none;
    }
  }
</style>
