---
interface Props {
  lang?: "zh" | "en";
}
const { lang = "zh" } = Astro.props;
const zh = lang === "zh";
---

<svg viewBox="0 0 920 236" fill="none" xmlns="http://www.w3.org/2000/svg" class="uc-svg-diagram" role="img" aria-label={zh ? "OpenCode TUI 命令面板 UltraCode 双开关示意图" : "OpenCode TUI Command Palette UltraCode switches schematic"}>
  <rect x="0.5" y="0.5" width="919" height="235" rx="10" fill="#0A0A0A" stroke="rgba(255,255,255,0.09)"/>

  <!-- Search bar -->
  <rect x="32" y="26" width="856" height="42" rx="7" fill="#141414" stroke="rgba(255,255,255,0.12)"/>
  <text x="52" y="52" fill="#737373" font-family="JetBrains Mono, monospace" font-size="13">&gt;</text>
  <text x="72" y="52" fill="#F5F5F5" font-family="Sora, PingFang SC, sans-serif" font-size="13.5" font-weight="500">
    UltraCode
  </text>
  <text x="868" y="51" text-anchor="end" fill="#737373" font-family="Sora, PingFang SC, sans-serif" font-size="11.5">
    {zh ? "OpenCode TUI 命令面板" : "OpenCode TUI Command Palette"}
  </text>

  <!-- Switch 1 -->
  <rect x="32" y="88" width="414" height="118" rx="8" fill="rgba(34,211,238,0.06)" stroke="rgba(34,211,238,0.34)"/>
  <text x="54" y="120" fill="#F5F5F5" font-family="Sora, PingFang SC, sans-serif" font-size="15" font-weight="600">
    Command approvals · {zh ? "命令审批" : "Approvals"}
  </text>
  <rect x="364" y="101" width="62" height="26" rx="13" fill="rgba(34,211,238,0.22)" stroke="#22D3EE"/>
  <text x="395" y="118" text-anchor="middle" fill="#22D3EE" font-family="JetBrains Mono, monospace" font-size="11" font-weight="600">AUTO</text>
  <text x="54" y="152" fill="#E0E0E0" font-family="Sora, PingFang SC, sans-serif" font-size="12.5">
    {zh ? "默认自动放行常规操作，减少打断；" : "Auto-approves routine actions so work flows;"}
  </text>
  <text x="54" y="176" fill="#A3A3A3" font-family="Sora, PingFang SC, sans-serif" font-size="12">
    {zh ? "你明确禁止的危险规则始终保持生效。" : "Explicit deny rules always stay enforced."}
  </text>

  <!-- Switch 2 -->
  <rect x="474" y="88" width="414" height="118" rx="8" fill="#111111" stroke="rgba(255,255,255,0.12)"/>
  <text x="496" y="120" fill="#F5F5F5" font-family="Sora, PingFang SC, sans-serif" font-size="15" font-weight="600">
    Direction questions · {zh ? "方向询问" : "Direction"}
  </text>
  <rect x="786" y="101" width="82" height="26" rx="13" fill="rgba(255,255,255,0.08)" stroke="rgba(255,255,255,0.24)"/>
  <text x="827" y="118" text-anchor="middle" fill="#E5E5E5" font-family="JetBrains Mono, monospace" font-size="11" font-weight="600">MANUAL</text>
  <text x="496" y="152" fill="#E0E0E0" font-family="Sora, PingFang SC, sans-serif" font-size="12.5">
    {zh ? "默认遇到重大方向变化先问你再改；" : "Defaults to asking before major direction shifts;"}
  </text>
  <text x="496" y="176" fill="#A3A3A3" font-family="Sora, PingFang SC, sans-serif" font-size="12">
    {zh ? "想完全放手自动推进时可一键切为 auto。" : "Switch to auto anytime for full autonomy."}
  </text>
</svg>

<style>
  .uc-svg-diagram {
    width: 100%;
    height: auto;
    display: block;
  }
</style>
