---
import { DIAGRAMS_COPY, type Locale } from "../../i18n/ui";

interface Props {
  lang?: Locale;
}
const { lang = "en" } = Astro.props;
const t = DIAGRAMS_COPY[lang].controls;
---

<div class="uc-tui-panel" role="group" aria-label={t.aria}>
  <div class="uc-tui-search" dir="ltr">
    <span class="uc-caret">&gt;</span>
    <span>UltraCode</span>
    <span class="uc-surfaces-meta" dir="auto">{t.surfacesMeta}</span>
  </div>
  <div class="uc-tui-grid">
    <div class="uc-tui-item">
      <div class="uc-tui-top">
        <h3>{t.approvalsTitle}</h3>
        <span class="uc-state is-ice" dir="ltr"><i aria-hidden="true"></i>AUTO</span>
      </div>
      <p>{t.approvalsSub}</p>
    </div>
    <div class="uc-tui-item">
      <div class="uc-tui-top">
        <h3>{t.directionTitle}</h3>
        <span class="uc-state is-amber" dir="ltr"><i aria-hidden="true"></i>MANUAL</span>
      </div>
      <p>{t.directionSub}</p>
    </div>
  </div>
</div>

<style>
  .uc-tui-panel {
    border-top: 1px solid rgba(255, 255, 255, 0.12);
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    text-align: start;
  }

  .uc-tui-search {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    padding: 0.9rem 0.25rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    font-size: 0.98rem;
    font-weight: 500;
    color: #ffffff;
  }

  .uc-caret {
    font-family: var(--uc-font-mono);
    color: #e5a03d;
  }

  .uc-surfaces-meta {
    margin-left: auto;
    font-family: var(--uc-font-mono);
    font-size: 0.78rem;
    font-weight: 400;
    color: #8a8a8a;
  }

  .uc-tui-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .uc-tui-item {
    padding-block: 1.5rem;
    padding-inline: 0.25rem 1.75rem;
    border-inline-end: 1px solid rgba(255, 255, 255, 0.08);
  }

  .uc-tui-item:last-child {
    padding-block: 1.5rem;
    padding-inline: 1.75rem 0.25rem;
    border-inline-end: none;
  }

  .uc-tui-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    margin-bottom: 0.7rem;
  }

  .uc-tui-top h3 {
    margin: 0 !important;
    font-size: 1.02rem !important;
    font-weight: 500 !important;
    color: #ffffff !important;
  }

  .uc-state {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-family: var(--uc-font-mono);
    font-size: 0.82rem;
    font-weight: 500;
    white-space: nowrap;
  }

  .uc-state i {
    width: 6px;
    height: 6px;
    border-radius: 999px;
    display: inline-block;
  }

  .uc-state.is-ice {
    color: #bae6fd;
  }

  .uc-state.is-ice i {
    background: #bae6fd;
  }

  .uc-state.is-amber {
    color: #e5a03d;
  }

  .uc-state.is-amber i {
    background: #e5a03d;
  }

  .uc-tui-item p {
    margin: 0 !important;
    font-size: 0.92rem !important;
    line-height: 1.65 !important;
    color: #b5b5b5 !important;
  }

  @media (max-width: 720px) {
    .uc-tui-grid {
      grid-template-columns: 1fr;
    }

    .uc-tui-item,
    .uc-tui-item:last-child {
      padding: 1.25rem 0.25rem;
      border-inline-end: none;
    }

    .uc-tui-item {
      border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    }
  }
</style>
