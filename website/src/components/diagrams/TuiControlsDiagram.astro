---
interface Props {
  lang?: "zh" | "en";
}
const { lang = "zh" } = Astro.props;
const zh = lang === "zh";
---

<svg viewBox="0 0 960 206" fill="none" xmlns="http://www.w3.org/2000/svg" class="uc-svg-diagram" role="img" aria-label={zh ? "OpenCode TUI 命令面板 UltraCode 双开关示意图" : "OpenCode TUI Command Palette UltraCode switches schematic"}>
  <line x1="0" y1="0.5" x2="960" y2="0.5" stroke="rgba(255,255,255,0.1)"/>
  <line x1="0" y1="54.5" x2="960" y2="54.5" stroke="rgba(255,255,255,0.08)"/>
  <line x1="0" y1="205.5" x2="960" y2="205.5" stroke="rgba(255,255,255,0.08)"/>
  <line x1="480.5" y1="55" x2="480.5" y2="205" stroke="rgba(255,255,255,0.08)"/>

  <text x="16" y="34" fill="#E5A03D" font-family="JetBrains Mono, monospace" font-size="16">&gt;</text>
  <text x="40" y="34" fill="#FFFFFF" font-family="Sora, PingFang SC, sans-serif" font-size="16" font-weight="500">UltraCode</text>

  <!-- Left switch: Command approvals -->
  <text x="16" y="102" fill="#FFFFFF" font-family="Sora, PingFang SC, sans-serif" font-size="17" font-weight="500">
    Command approvals · {zh ? "命令审批" : "Approvals"}
  </text>
  <circle cx="386" cy="96" r="4" fill="#BAE6FD"/>
  <text x="400" y="101" fill="#BAE6FD" font-family="JetBrains Mono, monospace" font-size="14" font-weight="500">AUTO</text>
  <text x="16" y="140" fill="#B5B5B5" font-family="Sora, PingFang SC, sans-serif" font-size="14.5">
    {zh ? "默认自动放行常规操作，减少中断；" : "Auto-approves routine actions so work flows;"}
  </text>
  <text x="16" y="168" fill="#A3A3A3" font-family="Sora, PingFang SC, sans-serif" font-size="14.5">
    {zh ? "显式禁止的危险规则始终保持生效。" : "explicit deny rules always stay enforced."}
  </text>

  <!-- Right switch: Direction questions -->
  <text x="508" y="102" fill="#FFFFFF" font-family="Sora, PingFang SC, sans-serif" font-size="17" font-weight="500">
    Direction questions · {zh ? "方向询问" : "Direction"}
  </text>
  <circle cx="868" cy="96" r="4" fill="#E5A03D"/>
  <text x="882" y="101" fill="#E5A03D" font-family="JetBrains Mono, monospace" font-size="14" font-weight="500">MANUAL</text>
  <text x="508" y="140" fill="#B5B5B5" font-family="Sora, PingFang SC, sans-serif" font-size="14.5">
    {zh ? "默认重大方向变化先问你再改；" : "Asks before major direction shifts by default;"}
  </text>
  <text x="508" y="168" fill="#A3A3A3" font-family="Sora, PingFang SC, sans-serif" font-size="14.5">
    {zh ? "想完全放手推进时可随时切为 auto。" : "toggle to auto anytime for full autonomy."}
  </text>
</svg>

<style>
  .uc-svg-diagram {
    width: 100%;
    height: auto;
    display: block;
  }
</style>
