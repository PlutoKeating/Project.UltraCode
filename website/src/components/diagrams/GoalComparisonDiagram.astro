---
interface Props {
  lang?: "zh" | "en";
}
const { lang = "zh" } = Astro.props;
const zh = lang === "zh";
---

<svg viewBox="0 0 960 300" fill="none" xmlns="http://www.w3.org/2000/svg" class="uc-svg-diagram" role="img" aria-label={zh ? "普通对话与 UltraCode 目标工程对比示意图" : "Ordinary chat vs UltraCode Goal Engineering diagram"}>
  <defs>
    <filter id="iceGlow" x="-15%" y="-40%" width="130%" height="180%">
      <feGaussianBlur stdDeviation="4" result="blur"/>
      <feMerge>
        <feMergeNode in="blur"/>
        <feMergeNode in="SourceGraphic"/>
      </feMerge>
    </filter>
  </defs>

  <!-- Open-canvas architectural hairlines & crosshairs (zero outer box) -->
  <line x1="0" y1="0.5" x2="960" y2="0.5" stroke="rgba(255,255,255,0.08)"/>
  <line x1="0" y1="146.5" x2="960" y2="146.5" stroke="rgba(255,255,255,0.08)"/>
  <line x1="0" y1="299.5" x2="960" y2="299.5" stroke="rgba(255,255,255,0.08)"/>
  <line x1="240.5" y1="0" x2="240.5" y2="300" stroke="rgba(255,255,255,0.045)"/>
  <line x1="480.5" y1="0" x2="480.5" y2="300" stroke="rgba(255,255,255,0.045)"/>
  <line x1="720.5" y1="0" x2="720.5" y2="300" stroke="rgba(255,255,255,0.045)"/>

  <!-- Precision + registration marks -->
  <path d="M236.5 146.5H244.5 M240.5 142.5V150.5 M476.5 146.5H484.5 M480.5 142.5V150.5 M716.5 146.5H724.5 M720.5 142.5V150.5" stroke="rgba(255,255,255,0.28)" stroke-width="1"/>

  <!-- Top Track: Ordinary Chat -->
  <text x="16" y="34" fill="#737373" font-family="Sora, PingFang SC, sans-serif" font-size="13" font-weight="500">
    {zh ? "普通 AI 对话" : "Ordinary AI Chat"}
  </text>
  <circle cx="748" cy="30" r="2.5" fill="#E5A03D"/>
  <text x="760" y="34" fill="#8A8A8A" font-family="JetBrains Mono, PingFang SC, sans-serif" font-size="11.5">
    {zh ? "猜需求 · 忘上下文 · 口头完工" : "Guesses · Drifts · Self-certified"}
  </text>

  <path d="M 36 96 C 170 62, 310 64, 450 86 C 590 108, 700 116, 904 106" stroke="#525252" stroke-width="1.5" stroke-dasharray="4 5"/>
  <circle cx="36" cy="96" r="3.5" fill="#525252"/>
  <circle cx="290" cy="70" r="3.5" fill="#525252"/>
  <circle cx="560" cy="100" r="4" fill="#E5A03D"/>
  <path d="M 898 100 L 910 112 M 910 100 L 898 112" stroke="#E5A03D" stroke-width="1.5"/>

  <text x="36" y="126" fill="#636363" font-family="Sora, PingFang SC, sans-serif" font-size="12">{zh ? "直接盲写" : "Starts guessing"}</text>
  <text x="290" y="126" text-anchor="middle" fill="#636363" font-family="Sora, PingFang SC, sans-serif" font-size="12">{zh ? "长对话跑偏" : "Drifts mid-task"}</text>
  <text x="560" y="126" text-anchor="middle" fill="#E5A03D" font-family="Sora, PingFang SC, sans-serif" font-size="12">{zh ? "改坏旧逻辑" : "Silent regression"}</text>
  <text x="904" y="126" text-anchor="end" fill="#8A8A8A" font-family="Sora, PingFang SC, sans-serif" font-size="12">{zh ? "半成品收尾" : "Stops early"}</text>

  <!-- Bottom Track: UltraCode Goal Engineering (Pure white optical laser core + subtle ice bloom) -->
  <text x="16" y="182" fill="#FFFFFF" font-family="Sora, PingFang SC, sans-serif" font-size="13.5" font-weight="500">
    {zh ? "UltraCode 目标工程" : "UltraCode Goal Engineering"}
  </text>
  <circle cx="748" cy="178" r="2.5" fill="#BAE6FD"/>
  <text x="760" y="182" fill="#D4D4D4" font-family="JetBrains Mono, PingFang SC, sans-serif" font-size="11.5">
    {zh ? "先对齐 · 独立验收 · 持久交付" : "Aligned · Verified · Durable"}
  </text>

  <path d="M 36 244 L 310 232 L 590 222 L 904 208" stroke="#BAE6FD" stroke-opacity="0.45" stroke-width="4" filter="url(#iceGlow)"/>
  <path d="M 36 244 L 310 232 L 590 222 L 904 208" stroke="#FFFFFF" stroke-width="1.6"/>

  <circle cx="36" cy="244" r="4.5" fill="#000000" stroke="#FFFFFF" stroke-width="1.6"/>
  <circle cx="310" cy="232" r="4.5" fill="#000000" stroke="#FFFFFF" stroke-width="1.6"/>
  <circle cx="590" cy="222" r="4.5" fill="#000000" stroke="#FFFFFF" stroke-width="1.6"/>
  <circle cx="904" cy="208" r="6" fill="#FFFFFF"/>
  <circle cx="904" cy="208" r="11" stroke="rgba(186,230,253,0.45)" stroke-width="1"/>

  <text x="36" y="276" fill="#D4D4D4" font-family="Sora, PingFang SC, sans-serif" font-size="12.5">{zh ? "01 先调研出选择题" : "01 Research & clarify"}</text>
  <text x="310" y="276" text-anchor="middle" fill="#D4D4D4" font-family="Sora, PingFang SC, sans-serif" font-size="12.5">{zh ? "02 锁定方案再动工" : "02 Lock plan first"}</text>
  <text x="590" y="276" text-anchor="middle" fill="#D4D4D4" font-family="Sora, PingFang SC, sans-serif" font-size="12.5">{zh ? "03 多角色隔离协作" : "03 Subagent execution"}</text>
  <text x="904" y="276" text-anchor="end" fill="#FFFFFF" font-family="Sora, PingFang SC, sans-serif" font-size="12.5" font-weight="500">{zh ? "04 真机浏览器目视验收" : "04 Real-browser QA"}</text>
</svg>

<style>
  .uc-svg-diagram {
    width: 100%;
    height: auto;
    display: block;
  }
</style>
