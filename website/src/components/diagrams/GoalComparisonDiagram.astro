---
import { DIAGRAMS_COPY, svgBidi, type Locale } from "../../i18n/ui";

interface Props {
  lang?: Locale;
}
const { lang = "en" } = Astro.props;
const t = DIAGRAMS_COPY[lang].comparison;
const metaFont = lang === "ar" ? "var(--uc-font-sans)" : "var(--uc-font-mono)";
---

<svg viewBox="0 0 760 288" fill="none" xmlns="http://www.w3.org/2000/svg" class="uc-svg-diagram" role="img" aria-label={t.aria}>
  <defs>
    <filter id="iceGlow" x="-15%" y="-40%" width="130%" height="180%">
      <feGaussianBlur stdDeviation="3.5" result="blur"/>
      <feMerge>
        <feMergeNode in="blur"/>
        <feMergeNode in="SourceGraphic"/>
      </feMerge>
    </filter>
  </defs>

  <line x1="0" y1="0.5" x2="760" y2="0.5" stroke="rgba(255,255,255,0.08)"/>
  <line x1="0" y1="142.5" x2="760" y2="142.5" stroke="rgba(255,255,255,0.08)"/>
  <line x1="0" y1="287.5" x2="760" y2="287.5" stroke="rgba(255,255,255,0.08)"/>
  <line x1="190.5" y1="0" x2="190.5" y2="288" stroke="rgba(255,255,255,0.045)"/>
  <line x1="380.5" y1="0" x2="380.5" y2="288" stroke="rgba(255,255,255,0.045)"/>
  <line x1="570.5" y1="0" x2="570.5" y2="288" stroke="rgba(255,255,255,0.045)"/>
  <path d="M186.5 142.5H194.5 M190.5 138.5V146.5 M376.5 142.5H384.5 M380.5 138.5V146.5 M566.5 142.5H574.5 M570.5 138.5V146.5" stroke="rgba(255,255,255,0.28)" stroke-width="1"/>

  <text x="16" y="34" fill="#B5B5B5" font-family="var(--uc-font-sans)" font-size="15.5" font-weight="500">
    {svgBidi(lang, t.topTitle)}
  </text>
  <text x="744" y="34" text-anchor="end" fill="#B5B5B5" font-family={metaFont} font-size="12">
    {svgBidi(lang, t.topMeta)}
  </text>

  <path d="M 24 92 C 140 60, 250 62, 360 82 C 470 102, 560 110, 736 100" stroke="#737373" stroke-width="1.6" stroke-dasharray="4 5"/>
  <circle cx="24" cy="92" r="4" fill="#8A8A8A"/>
  <circle cx="256" cy="68" r="4" fill="#8A8A8A"/>
  <circle cx="468" cy="96" r="4.5" fill="#E5A03D"/>
  <path d="M 730 94 L 742 106 M 742 94 L 730 106" stroke="#E5A03D" stroke-width="1.8"/>

  <text x="20" y="126" fill="#A3A3A3" font-family="var(--uc-font-sans)" font-size="13.5">{svgBidi(lang, t.t1)}</text>
  <text x="256" y="126" text-anchor="middle" fill="#A3A3A3" font-family="var(--uc-font-sans)" font-size="13.5">{svgBidi(lang, t.t2)}</text>
  <text x="468" y="126" text-anchor="middle" fill="#E5A03D" font-family="var(--uc-font-sans)" font-size="13.5">{svgBidi(lang, t.t3)}</text>
  <text x="744" y="126" text-anchor="end" fill="#B5B5B5" font-family="var(--uc-font-sans)" font-size="13.5">{svgBidi(lang, t.t4)}</text>

  <text x="16" y="178" fill="#FFFFFF" font-family="var(--uc-font-sans)" font-size="16" font-weight="500">
    {svgBidi(lang, t.botTitle)}
  </text>
  <text x="744" y="178" text-anchor="end" fill="#E5E5E5" font-family={metaFont} font-size="12">
    {svgBidi(lang, t.botMeta)}
  </text>

  <path d="M 24 234 L 256 224 L 468 214 L 736 202" stroke="#BAE6FD" stroke-opacity="0.45" stroke-width="4" filter="url(#iceGlow)"/>
  <path d="M 24 234 L 256 224 L 468 214 L 736 202" stroke="#FFFFFF" stroke-width="1.8"/>

  <circle cx="24" cy="234" r="5" fill="#000000" stroke="#FFFFFF" stroke-width="1.8"/>
  <circle cx="256" cy="224" r="5" fill="#000000" stroke="#FFFFFF" stroke-width="1.8"/>
  <circle cx="468" cy="214" r="5" fill="#000000" stroke="#FFFFFF" stroke-width="1.8"/>
  <circle cx="736" cy="202" r="6" fill="#FFFFFF"/>
  <circle cx="736" cy="202" r="11" stroke="rgba(186,230,253,0.45)" stroke-width="1"/>

  <text x="20" y="270" fill="#E5E5E5" font-family="var(--uc-font-sans)" font-size="13.5">{svgBidi(lang, t.b1)}</text>
  <text x="256" y="270" text-anchor="middle" fill="#E5E5E5" font-family="var(--uc-font-sans)" font-size="13.5">{svgBidi(lang, t.b2)}</text>
  <text x="468" y="270" text-anchor="middle" fill="#E5E5E5" font-family="var(--uc-font-sans)" font-size="13.5">{svgBidi(lang, t.b3)}</text>
  <text x="744" y="270" text-anchor="end" fill="#FFFFFF" font-family="var(--uc-font-sans)" font-size="13.5" font-weight="500">{svgBidi(lang, t.b4)}</text>
</svg>

<style>
  .uc-svg-diagram {
    width: 100%;
    height: auto;
    display: block;
    direction: ltr;
  }
</style>
