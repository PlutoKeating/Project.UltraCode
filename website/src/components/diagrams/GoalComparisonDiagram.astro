---
interface Props {
  lang?: "zh" | "en";
}
const { lang = "zh" } = Astro.props;
const zh = lang === "zh";
---

<svg viewBox="0 0 760 288" fill="none" xmlns="http://www.w3.org/2000/svg" class="uc-svg-diagram" role="img" aria-label={zh ? "普通对话与 UltraCode 目标工程对比示意图" : "Ordinary chat vs UltraCode Goal Engineering diagram"}>
  <defs>
    <filter id="iceGlow" x="-15%" y="-40%" width="130%" height="180%">
      <feGaussianBlur stdDeviation="3.5" result="blur"/>
      <feMerge>
        <feMergeNode in="blur"/>
        <feMergeNode in="SourceGraphic"/>
      </feMerge>
    </filter>
  </defs>

  <line x1="0" y1="0.5" x2="760" y2="0.5" stroke="rgba(255,255,255,0.08)"/>
  <line x1="0" y1="142.5" x2="760" y2="142.5" stroke="rgba(255,255,255,0.08)"/>
  <line x1="0" y1="287.5" x2="760" y2="287.5" stroke="rgba(255,255,255,0.08)"/>
  <line x1="190.5" y1="0" x2="190.5" y2="288" stroke="rgba(255,255,255,0.045)"/>
  <line x1="380.5" y1="0" x2="380.5" y2="288" stroke="rgba(255,255,255,0.045)"/>
  <line x1="570.5" y1="0" x2="570.5" y2="288" stroke="rgba(255,255,255,0.045)"/>
  <path d="M186.5 142.5H194.5 M190.5 138.5V146.5 M376.5 142.5H384.5 M380.5 138.5V146.5 M566.5 142.5H574.5 M570.5 138.5V146.5" stroke="rgba(255,255,255,0.28)" stroke-width="1"/>

  <!-- Top Track: Ordinary Chat -->
  <text x="12" y="34" fill="#B5B5B5" font-family="Sora, PingFang SC, sans-serif" font-size="15.5" font-weight="500">
    {zh ? "普通 AI 对话" : "Ordinary AI Chat"}
  </text>
  <circle cx="516" cy="29" r="3" fill="#E5A03D"/>
  <text x="530" y="34" fill="#B5B5B5" font-family="JetBrains Mono, PingFang SC, sans-serif" font-size="13.5">
    {zh ? "猜需求 · 忘上下文 · 口头完工" : "Guesses · Drifts · Self-certified"}
  </text>

  <path d="M 28 92 C 140 60, 250 62, 360 82 C 470 102, 560 110, 718 100" stroke="#737373" stroke-width="1.6" stroke-dasharray="4 5"/>
  <circle cx="28" cy="92" r="4" fill="#8A8A8A"/>
  <circle cx="236" cy="68" r="4" fill="#8A8A8A"/>
  <circle cx="448" cy="96" r="4.5" fill="#E5A03D"/>
  <path d="M 712 94 L 724 106 M 724 94 L 712 106" stroke="#E5A03D" stroke-width="1.8"/>

  <text x="28" y="126" fill="#A3A3A3" font-family="Sora, PingFang SC, sans-serif" font-size="14">{zh ? "直接盲写" : "Starts guessing"}</text>
  <text x="236" y="126" text-anchor="middle" fill="#A3A3A3" font-family="Sora, PingFang SC, sans-serif" font-size="14">{zh ? "长对话跑偏" : "Drifts mid-task"}</text>
  <text x="448" y="126" text-anchor="middle" fill="#E5A03D" font-family="Sora, PingFang SC, sans-serif" font-size="14">{zh ? "改坏旧逻辑" : "Silent regression"}</text>
  <text x="718" y="126" text-anchor="end" fill="#B5B5B5" font-family="Sora, PingFang SC, sans-serif" font-size="14">{zh ? "半成品收尾" : "Stops early"}</text>

  <!-- Bottom Track: UltraCode Goal Engineering -->
  <text x="12" y="178" fill="#FFFFFF" font-family="Sora, PingFang SC, sans-serif" font-size="16" font-weight="500">
    {zh ? "UltraCode 目标工程" : "UltraCode Goal Engineering"}
  </text>
  <circle cx="516" cy="173" r="3" fill="#BAE6FD"/>
  <text x="530" y="178" fill="#E5E5E5" font-family="JetBrains Mono, PingFang SC, sans-serif" font-size="13.5">
    {zh ? "先对齐 · 独立验收 · 持久交付" : "Aligned · Verified · Durable"}
  </text>

  <path d="M 28 234 L 254 224 L 484 214 L 718 202" stroke="#BAE6FD" stroke-opacity="0.45" stroke-width="4" filter="url(#iceGlow)"/>
  <path d="M 28 234 L 254 224 L 484 214 L 718 202" stroke="#FFFFFF" stroke-width="1.8"/>

  <circle cx="28" cy="234" r="5" fill="#000000" stroke="#FFFFFF" stroke-width="1.8"/>
  <circle cx="254" cy="224" r="5" fill="#000000" stroke="#FFFFFF" stroke-width="1.8"/>
  <circle cx="484" cy="214" r="5" fill="#000000" stroke="#FFFFFF" stroke-width="1.8"/>
  <circle cx="718" cy="202" r="6" fill="#FFFFFF"/>
  <circle cx="718" cy="202" r="11" stroke="rgba(186,230,253,0.45)" stroke-width="1"/>

  <text x="28" y="270" fill="#E5E5E5" font-family="Sora, PingFang SC, sans-serif" font-size="14.5">{zh ? "01 先调研出选择题" : "01 Research & clarify"}</text>
  <text x="254" y="270" text-anchor="middle" fill="#E5E5E5" font-family="Sora, PingFang SC, sans-serif" font-size="14.5">{zh ? "02 锁定方案再动工" : "02 Lock plan first"}</text>
  <text x="484" y="270" text-anchor="middle" fill="#E5E5E5" font-family="Sora, PingFang SC, sans-serif" font-size="14.5">{zh ? "03 多角色隔离协作" : "03 Subagent execution"}</text>
  <text x="718" y="270" text-anchor="end" fill="#FFFFFF" font-family="Sora, PingFang SC, sans-serif" font-size="14.5" font-weight="500">{zh ? "04 真机浏览器验收" : "04 Real-browser QA"}</text>
</svg>

<style>
  .uc-svg-diagram {
    width: 100%;
    height: auto;
    display: block;
  }
</style>
