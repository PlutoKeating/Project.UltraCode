---
interface Props {
  lang?: "zh" | "en";
}
const { lang = "zh" } = Astro.props;
const zh = lang === "zh";
---

<div class="uc-stage-wrap">
  <div class="uc-specular-rim" aria-hidden="true"></div>
  <div class="uc-stage" aria-label={zh ? "UltraCode 工作流与真机视觉验收实景示意" : "UltraCode workflow and real-browser visual QA preview"}>
    <div class="uc-stage-pane uc-stage-tui">
      <div class="uc-pane-bar">
        <span class="uc-pane-title">OPENCODE / ULTRABUILD</span>
        <span class="uc-status-led">
          <span class="uc-led uc-led-ice" aria-hidden="true"></span>
          <span>{zh ? "目标工程运行中" : "GOAL ENGINE LIVE"}</span>
        </span>
      </div>

      <div class="uc-tui-body">
        <div class="uc-tui-prompt">
          <span class="uc-tui-chevron">&gt;</span>
          <span>
            {zh
              ? "做一个个人作品集主页，克制暗色风格，桌面和手机都要好看。"
              : "Build a restrained dark portfolio page that looks sharp on desktop and mobile."}
          </span>
        </div>

        <div class="uc-tui-label">
          {zh ? "先一次性澄清关键决策" : "Clarifying key decisions upfront"}
        </div>

        <div class="uc-choice-row">
          <div class="uc-choice-item is-selected">
            <div class="uc-choice-head">
              <span>{zh ? "纯黑光学暗场" : "Obsidian Optical"}</span>
              <span class="uc-choice-dot"></span>
            </div>
            <p>{zh ? "正黑底 + 冰青光刃" : "Pure black + ice blade"}</p>
          </div>
          <div class="uc-choice-item">
            <div class="uc-choice-head">
              <span>{zh ? "瑞士工业网格" : "Swiss Hairline"}</span>
              <span class="uc-choice-ring"></span>
            </div>
            <p>{zh ? "1px 精密结构线" : "1px precision grid"}</p>
          </div>
          <div class="uc-choice-item">
            <div class="uc-choice-head">
              <span>{zh ? "纸面编辑排版" : "Editorial Light"}</span>
              <span class="uc-choice-ring"></span>
            </div>
            <p>{zh ? "极简浅灰高对比" : "Crisp alabaster ink"}</p>
          </div>
        </div>

        <div class="uc-milestones">
          <div class="uc-tui-label">{zh ? "自动推进里程碑" : "Autonomous milestones"}</div>
          <ul>
            <li>
              <span class="uc-tick" aria-hidden="true"></span>
              <span>{zh ? "需求澄清与架构方案已锁定" : "Scope clarified & architecture locked"}</span>
            </li>
            <li>
              <span class="uc-tick" aria-hidden="true"></span>
              <span>{zh ? "子代理并行实现与独立代码评审通过" : "Subagent build & independent review passed"}</span>
            </li>
            <li class="is-active">
              <span class="uc-tick uc-tick-ice" aria-hidden="true"></span>
              <span>{zh ? "真机浏览器桌面/移动端目视验收通过" : "Real browser desktop & mobile QA passed"}</span>
            </li>
          </ul>
        </div>
      </div>
    </div>

    <div class="uc-stage-divider" aria-hidden="true"></div>

    <div class="uc-stage-pane uc-stage-browser">
      <div class="uc-browser-chrome">
        <div class="uc-browser-url">CHROMIUM · 1440×900 · LOCALHOST</div>
        <span class="uc-status-led">
          <span class="uc-led uc-led-ice" aria-hidden="true"></span>
          <span>{zh ? "视觉验收通过" : "VISUAL QA PASSED"}</span>
        </span>
      </div>

      <div class="uc-browser-viewport">
        <svg viewBox="0 0 460 270" fill="none" xmlns="http://www.w3.org/2000/svg" role="img" aria-label={zh ? "真机浏览器视觉检查示意图" : "Headless browser visual inspection diagram"}>
          <!-- Borderless optical wireframe viewport -->
          <line x1="0" y1="0.5" x2="460" y2="0.5" stroke="rgba(255,255,255,0.08)"/>
          <line x1="96.5" y1="0" x2="96.5" y2="270" stroke="rgba(255,255,255,0.07)"/>

          <!-- Sidebar skeleton -->
          <rect x="14" y="20" width="48" height="5" fill="#FFFFFF" fill-opacity="0.78"/>
          <rect x="14" y="44" width="60" height="4" fill="rgba(255,255,255,0.18)"/>
          <rect x="14" y="60" width="44" height="4" fill="rgba(255,255,255,0.10)"/>
          <rect x="14" y="76" width="52" height="4" fill="rgba(255,255,255,0.10)"/>
          <rect x="14" y="92" width="38" height="4" fill="rgba(255,255,255,0.10)"/>

          <!-- Main header skeleton -->
          <rect x="120" y="20" width="156" height="9" fill="#FFFFFF" fill-opacity="0.88"/>
          <rect x="120" y="38" width="210" height="4" fill="rgba(255,255,255,0.22)"/>

          <!-- Inspection reticle region 1 -->
          <rect x="120" y="64" width="152" height="86" fill="rgba(255,255,255,0.02)" stroke="rgba(255,255,255,0.12)"/>
          <path d="M120 74V64H130 M262 64H272V74 M120 140V150H130 M262 150H272V140" stroke="#BAE6FD" stroke-width="1.2"/>
          <rect x="134" y="82" width="64" height="5" fill="rgba(255,255,255,0.45)"/>
          <rect x="134" y="98" width="114" height="4" fill="rgba(255,255,255,0.16)"/>
          <rect x="134" y="110" width="90" height="4" fill="rgba(255,255,255,0.10)"/>
          <rect x="134" y="126" width="48" height="10" fill="#FFFFFF" fill-opacity="0.9"/>

          <!-- Inspection reticle region 2: optical curve -->
          <rect x="288" y="64" width="152" height="86" fill="rgba(255,255,255,0.02)" stroke="rgba(255,255,255,0.09)"/>
          <path d="M306 132 L338 116 L368 120 L398 94 L424 84" stroke="#FFFFFF" stroke-width="1.5" stroke-linecap="square"/>
          <circle cx="398" cy="94" r="3" fill="#E5A03D"/>
          <circle cx="424" cy="84" r="3.5" fill="#BAE6FD"/>

          <!-- Bottom verification readout -->
          <line x1="120" y1="176" x2="440" y2="176" stroke="rgba(255,255,255,0.08)"/>
          <rect x="120" y="194" width="88" height="5" fill="rgba(255,255,255,0.28)"/>
          <rect x="120" y="210" width="276" height="4" fill="rgba(255,255,255,0.12)"/>
          <rect x="120" y="222" width="224" height="4" fill="rgba(255,255,255,0.08)"/>
          <circle cx="124" cy="244" r="2.5" fill="#BAE6FD"/>
          <text x="135" y="247" fill="#A3A3A3" font-family="JetBrains Mono, monospace" font-size="9">
            {zh ? "对比度 · 溢出 · 交互 · 全部通过" : "CONTRAST · OVERFLOW · INTERACTION · PASS"}
          </text>
        </svg>
      </div>
    </div>
  </div>
</div>

<style>
  .uc-stage-wrap {
    position: relative;
    width: 100%;
  }

  /* Directional top-edge specular rim light (catches the anamorphic blade above) */
  .uc-specular-rim {
    position: absolute;
    top: 0;
    left: 6%;
    right: 6%;
    height: 1px;
    z-index: 3;
    background: linear-gradient(
      90deg,
      transparent 0%,
      rgba(186, 230, 253, 0.35) 28%,
      rgba(255, 255, 255, 0.72) 50%,
      rgba(229, 160, 61, 0.32) 72%,
      transparent 100%
    );
    pointer-events: none;
  }

  .uc-stage {
    position: relative;
    display: grid;
    grid-template-columns: 1.05fr 1px 1fr;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    border-left: 1px solid rgba(255, 255, 255, 0.06);
    border-right: 1px solid rgba(255, 255, 255, 0.06);
    border-bottom: none;
    border-radius: 10px 10px 0 0;
    background: linear-gradient(180deg, rgba(12, 12, 12, 0.86) 0%, rgba(6, 6, 6, 0.94) 65%, rgba(0, 0, 0, 0) 100%);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    overflow: hidden;
    text-align: left;
    /* Seamless fade into pitch black at the bottom — eliminates plastic box edge */
    -webkit-mask-image: linear-gradient(to bottom, #000 0%, #000 76%, transparent 100%);
    mask-image: linear-gradient(to bottom, #000 0%, #000 76%, transparent 100%);
  }

  .uc-stage-divider {
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.1), rgba(255, 255, 255, 0.02));
  }

  .uc-stage-pane {
    padding: 1.75rem 2rem 2.75rem;
    display: flex;
    flex-direction: column;
    gap: 1.35rem;
    min-width: 0;
  }

  .uc-pane-bar,
  .uc-browser-chrome {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    padding-bottom: 0.95rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.07);
    font-family: var(--uc-font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.06em;
    color: var(--uc-ink-secondary);
  }

  .uc-pane-title {
    color: #d4d4d4;
  }

  .uc-status-led {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    color: #b5b5b5;
    white-space: nowrap;
  }

  .uc-led {
    width: 5px;
    height: 5px;
    border-radius: 999px;
  }

  .uc-led-ice {
    background: #bae6fd;
    box-shadow: 0 0 8px rgba(186, 230, 253, 0.8);
  }

  .uc-tui-body {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .uc-tui-prompt {
    display: flex;
    align-items: flex-start;
    gap: 0.7rem;
    font-size: 0.92rem;
    line-height: 1.65;
    color: #ffffff;
    padding: 0.85rem 0 0.85rem 0.95rem;
    border-left: 1.5px solid rgba(255, 255, 255, 0.28);
  }

  .uc-tui-chevron {
    font-family: var(--uc-font-mono);
    color: var(--uc-amber);
    font-weight: 500;
  }

  .uc-tui-label {
    font-size: 0.76rem;
    letter-spacing: 0.03em;
    color: var(--uc-ink-muted);
  }

  /* Hairline-divided 3-column choice rail (zero nested plastic cards) */
  .uc-choice-row {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  .uc-choice-item {
    padding: 0.85rem 0.9rem;
    border-right: 1px solid rgba(255, 255, 255, 0.07);
  }

  .uc-choice-item:last-child {
    border-right: none;
  }

  .uc-choice-item.is-selected {
    background: rgba(255, 255, 255, 0.04);
  }

  .uc-choice-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.4rem;
    font-size: 0.82rem;
    font-weight: 500;
    color: #ffffff;
    margin-bottom: 0.35rem;
  }

  .uc-choice-dot {
    width: 6px;
    height: 6px;
    border-radius: 999px;
    background: #bae6fd;
    box-shadow: 0 0 8px rgba(186, 230, 253, 0.75);
    flex-shrink: 0;
  }

  .uc-choice-ring {
    width: 6px;
    height: 6px;
    border-radius: 999px;
    border: 1px solid rgba(255, 255, 255, 0.22);
    flex-shrink: 0;
  }

  .uc-choice-item p {
    margin: 0;
    font-size: 0.74rem;
    color: var(--uc-ink-secondary);
    line-height: 1.45;
  }

  .uc-milestones {
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
  }

  .uc-milestones ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .uc-milestones li {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    font-size: 0.84rem;
    line-height: 1.5;
    color: #9a9a9a;
  }

  .uc-milestones li.is-active {
    color: #ffffff;
  }

  .uc-tick {
    width: 5px;
    height: 5px;
    background: #525252;
    flex-shrink: 0;
  }

  .uc-tick-ice {
    background: #bae6fd;
    box-shadow: 0 0 8px rgba(186, 230, 253, 0.8);
  }

  .uc-browser-url {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .uc-browser-viewport {
    flex: 1;
    display: flex;
    align-items: center;
  }

  .uc-browser-viewport svg {
    width: 100%;
    height: auto;
    display: block;
  }

  @media (max-width: 900px) {
    .uc-stage {
      grid-template-columns: 1fr;
      -webkit-mask-image: linear-gradient(to bottom, #000 0%, #000 88%, transparent 100%);
      mask-image: linear-gradient(to bottom, #000 0%, #000 88%, transparent 100%);
    }

    .uc-stage-divider {
      height: 1px;
      width: 100%;
    }

    .uc-choice-row {
      grid-template-columns: 1fr;
    }

    .uc-choice-item {
      border-right: none;
      border-bottom: 1px solid rgba(255, 255, 255, 0.07);
    }

    .uc-choice-item:last-child {
      border-bottom: none;
    }
  }
</style>
