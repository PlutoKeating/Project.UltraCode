---
import { DIAGRAMS_COPY, type Locale } from "../../i18n/ui";

interface Props {
  lang?: Locale;
}
const { lang = "en" } = Astro.props;
const t = DIAGRAMS_COPY[lang].hero;
---

<div class="uc-stage-wrap">
  <div class="uc-specular-rim" aria-hidden="true"></div>
  <div class="uc-stage" aria-label={t.stageAria}>
    <div class="uc-stage-pane">
      <div class="uc-tui-prompt">
        <span class="uc-tui-chevron">&gt;</span>
        <span>{t.prompt}</span>
      </div>

      <div class="uc-choice-row">
        <div class="uc-choice-item is-selected">
          <div class="uc-choice-head">
            <span>{t.c1Title}</span>
            <span class="uc-choice-dot"></span>
          </div>
          <p>{t.c1Sub}</p>
        </div>
        <div class="uc-choice-item">
          <div class="uc-choice-head">
            <span>{t.c2Title}</span>
            <span class="uc-choice-ring"></span>
          </div>
          <p>{t.c2Sub}</p>
        </div>
        <div class="uc-choice-item">
          <div class="uc-choice-head">
            <span>{t.c3Title}</span>
            <span class="uc-choice-ring"></span>
          </div>
          <p>{t.c3Sub}</p>
        </div>
      </div>

      <ul class="uc-milestones">
        <li>
          <span class="uc-tick" aria-hidden="true"></span>
          <span>{t.m1}</span>
        </li>
        <li>
          <span class="uc-tick" aria-hidden="true"></span>
          <span>{t.m2}</span>
        </li>
        <li class="is-active">
          <span class="uc-tick uc-tick-ice" aria-hidden="true"></span>
          <span>{t.m3}</span>
        </li>
      </ul>
    </div>

    <div class="uc-stage-divider" aria-hidden="true"></div>

    <div class="uc-stage-pane">
      <div class="uc-browser-head">
        <span class="uc-led" aria-hidden="true"></span>
        <span>{t.browserHead}</span>
      </div>

      <div class="uc-browser-viewport" dir="ltr">
        <svg viewBox="0 0 460 250" fill="none" xmlns="http://www.w3.org/2000/svg" role="img" aria-label={t.browserAria}>
          <line x1="0" y1="0.5" x2="460" y2="0.5" stroke="rgba(255,255,255,0.08)"/>
          <line x1="92.5" y1="0" x2="92.5" y2="250" stroke="rgba(255,255,255,0.07)"/>

          <rect x="14" y="20" width="46" height="5" fill="#FFFFFF" fill-opacity="0.78"/>
          <rect x="14" y="44" width="56" height="4" fill="rgba(255,255,255,0.16)"/>
          <rect x="14" y="60" width="42" height="4" fill="rgba(255,255,255,0.10)"/>
          <rect x="14" y="76" width="50" height="4" fill="rgba(255,255,255,0.10)"/>

          <rect x="116" y="20" width="152" height="9" fill="#FFFFFF" fill-opacity="0.88"/>
          <rect x="116" y="38" width="204" height="4" fill="rgba(255,255,255,0.2)"/>

          <rect x="116" y="64" width="154" height="86" fill="rgba(255,255,255,0.02)" stroke="rgba(255,255,255,0.11)"/>
          <path d="M116 74V64H126 M260 64H270V74 M116 140V150H126 M260 150H270V140" stroke="#BAE6FD" stroke-width="1.2"/>
          <rect x="130" y="82" width="64" height="5" fill="rgba(255,255,255,0.45)"/>
          <rect x="130" y="98" width="114" height="4" fill="rgba(255,255,255,0.16)"/>
          <rect x="130" y="110" width="88" height="4" fill="rgba(255,255,255,0.10)"/>
          <rect x="130" y="126" width="48" height="10" fill="#FFFFFF" fill-opacity="0.9"/>

          <rect x="286" y="64" width="154" height="86" fill="rgba(255,255,255,0.02)" stroke="rgba(255,255,255,0.09)"/>
          <path d="M304 132 L338 116 L370 120 L400 94 L426 84" stroke="#FFFFFF" stroke-width="1.5" stroke-linecap="square"/>
          <circle cx="400" cy="94" r="3" fill="#E5A03D"/>
          <circle cx="426" cy="84" r="3.5" fill="#BAE6FD"/>

          <line x1="116" y1="176" x2="440" y2="176" stroke="rgba(255,255,255,0.08)"/>
          <rect x="116" y="194" width="88" height="5" fill="rgba(255,255,255,0.26)"/>
          <rect x="116" y="210" width="276" height="4" fill="rgba(255,255,255,0.12)"/>
          <rect x="116" y="222" width="220" height="4" fill="rgba(255,255,255,0.08)"/>
        </svg>
      </div>
    </div>
  </div>
</div>

<style>
  .uc-stage-wrap {
    position: relative;
    width: 100%;
  }

  .uc-specular-rim {
    position: absolute;
    top: 0;
    left: 6%;
    right: 6%;
    height: 1px;
    z-index: 3;
    background: linear-gradient(
      90deg,
      transparent 0%,
      rgba(186, 230, 253, 0.35) 28%,
      rgba(255, 255, 255, 0.72) 50%,
      rgba(229, 160, 61, 0.32) 72%,
      transparent 100%
    );
    pointer-events: none;
  }

  .uc-stage {
    position: relative;
    display: grid;
    grid-template-columns: 1.05fr 1px 1fr;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    border-left: 1px solid rgba(255, 255, 255, 0.06);
    border-right: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: 10px 10px 0 0;
    background: linear-gradient(180deg, rgba(12, 12, 12, 0.86) 0%, rgba(6, 6, 6, 0.94) 65%, rgba(0, 0, 0, 0) 100%);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    overflow: hidden;
    text-align: start;
    -webkit-mask-image: linear-gradient(to bottom, #000 0%, #000 76%, transparent 100%);
    mask-image: linear-gradient(to bottom, #000 0%, #000 76%, transparent 100%);
  }

  .uc-stage-divider {
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.1), rgba(255, 255, 255, 0.02));
  }

  .uc-stage-pane {
    padding: 2rem 2.1rem 2.75rem;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    min-width: 0;
  }

  .uc-tui-prompt {
    display: flex;
    align-items: flex-start;
    gap: 0.7rem;
    font-size: 0.94rem;
    line-height: 1.65;
    color: #ffffff;
    padding-block: 0.35rem;
    padding-inline-start: 0.95rem;
    border-inline-start: 1px solid rgba(255, 255, 255, 0.3);
  }

  .uc-tui-chevron {
    font-family: var(--uc-font-mono);
    color: var(--uc-amber);
  }

  .uc-choice-row {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  .uc-choice-item {
    padding: 0.9rem 0.9rem;
    border-inline-end: 1px solid rgba(255, 255, 255, 0.07);
  }

  .uc-choice-item:last-child {
    border-inline-end: none;
  }

  .uc-choice-item.is-selected {
    background: rgba(255, 255, 255, 0.04);
  }

  .uc-choice-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.4rem;
    font-size: 0.84rem;
    font-weight: 500;
    color: #ffffff;
    margin-bottom: 0.3rem;
  }

  .uc-choice-dot {
    width: 6px;
    height: 6px;
    border-radius: 999px;
    background: #bae6fd;
    box-shadow: 0 0 8px rgba(186, 230, 253, 0.75);
    flex-shrink: 0;
  }

  .uc-choice-ring {
    width: 6px;
    height: 6px;
    border-radius: 999px;
    border: 1px solid rgba(255, 255, 255, 0.22);
    flex-shrink: 0;
  }

  .uc-choice-item p {
    margin: 0;
    font-size: 0.75rem;
    color: var(--uc-ink-secondary);
    line-height: 1.45;
  }

  .uc-milestones {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.68rem;
  }

  .uc-milestones li {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    font-size: 0.86rem;
    line-height: 1.5;
    color: #8f8f8f;
  }

  .uc-milestones li.is-active {
    color: #ffffff;
  }

  .uc-tick {
    width: 5px;
    height: 5px;
    background: #525252;
    flex-shrink: 0;
  }

  .uc-tick-ice {
    background: #bae6fd;
    box-shadow: 0 0 8px rgba(186, 230, 253, 0.8);
  }

  .uc-browser-head {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    font-size: 0.84rem;
    color: #d4d4d4;
  }

  .uc-led {
    width: 6px;
    height: 6px;
    border-radius: 999px;
    background: #bae6fd;
    box-shadow: 0 0 8px rgba(186, 230, 253, 0.8);
  }

  .uc-browser-viewport {
    flex: 1;
    display: flex;
    align-items: center;
  }

  .uc-browser-viewport svg {
    width: 100%;
    height: auto;
    display: block;
  }

  @media (max-width: 900px) {
    .uc-stage {
      grid-template-columns: 1fr;
      -webkit-mask-image: linear-gradient(to bottom, #000 0%, #000 88%, transparent 100%);
      mask-image: linear-gradient(to bottom, #000 0%, #000 88%, transparent 100%);
    }

    .uc-stage-divider {
      height: 1px;
      width: 100%;
    }
  }

  @media (max-width: 640px) {
    .uc-stage-pane {
      padding: 1.45rem 1.25rem 2.25rem;
    }

    .uc-choice-row {
      grid-template-columns: 1fr;
    }

    .uc-choice-item {
      border-inline-end: none;
      border-bottom: 1px solid rgba(255, 255, 255, 0.07);
    }

    .uc-choice-item:last-child {
      border-bottom: none;
    }
  }
</style>
