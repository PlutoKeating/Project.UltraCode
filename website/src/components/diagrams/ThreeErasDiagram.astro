---
interface Props {
  lang?: "zh" | "en";
}
const { lang = "zh" } = Astro.props;
const zh = lang === "zh";
---

<svg viewBox="0 0 920 184" fill="none" xmlns="http://www.w3.org/2000/svg" class="uc-svg-diagram" role="img" aria-label={zh ? "Prompt、Context、Goal 三代工程演进图" : "Evolution from Prompt to Context to Goal Engineering"}>
  <!-- 3-column architectural hairline table -->
  <line x1="0" y1="0.5" x2="920" y2="0.5" stroke="rgba(255,255,255,0.08)"/>
  <line x1="0" y1="183.5" x2="920" y2="183.5" stroke="rgba(255,255,255,0.08)"/>
  <line x1="306.5" y1="0" x2="306.5" y2="184" stroke="rgba(255,255,255,0.08)"/>
  <line x1="613.5" y1="0" x2="613.5" y2="184" stroke="rgba(255,255,255,0.08)"/>
  <line x1="614" y1="0.5" x2="920" y2="0.5" stroke="#BAE6FD" stroke-width="1.6"/>

  <!-- Gen 01 -->
  <text x="20" y="36" fill="#525252" font-family="JetBrains Mono, monospace" font-size="11">GEN 01</text>
  <text x="20" y="72" fill="#A3A3A3" font-family="Sora, PingFang SC, sans-serif" font-size="17" font-weight="500">Prompt Engineering</text>
  <text x="20" y="106" fill="#737373" font-family="Sora, PingFang SC, sans-serif" font-size="12.5">{zh ? "反复打磨单句提示词" : "Polishing one-shot prompts"}</text>
  <text x="20" y="144" fill="#525252" font-family="Sora, PingFang SC, sans-serif" font-size="11.5">{zh ? "局限：任务一长就失忆、跑偏" : "Limit: breaks on multi-step work"}</text>

  <!-- Gen 02 -->
  <text x="328" y="36" fill="#737373" font-family="JetBrains Mono, monospace" font-size="11">GEN 02</text>
  <text x="328" y="72" fill="#D4D4D4" font-family="Sora, PingFang SC, sans-serif" font-size="17" font-weight="500">Context Engineering</text>
  <text x="328" y="106" fill="#8A8A8A" font-family="Sora, PingFang SC, sans-serif" font-size="12.5">{zh ? "给模型喂对文档、工具与记忆" : "Curating right docs & memory"}</text>
  <text x="328" y="144" fill="#636363" font-family="Sora, PingFang SC, sans-serif" font-size="11.5">{zh ? "局限：看懂了却仍会偷懒或自评过关" : "Limit: still drifts or self-approves"}</text>

  <!-- Gen 03 -->
  <text x="636" y="36" fill="#BAE6FD" font-family="JetBrains Mono, monospace" font-size="11">GEN 03 · ULTRACODE</text>
  <text x="636" y="72" fill="#FFFFFF" font-family="Sora, PingFang SC, sans-serif" font-size="17" font-weight="500">{zh ? "Goal Engineering 目标工程" : "Goal Engineering"}</text>
  <text x="636" y="106" fill="#D4D4D4" font-family="Sora, PingFang SC, sans-serif" font-size="12.5">{zh ? "以可验证的最终目标驱动全程" : "Outcome-driven autonomous delivery"}</text>
  <text x="636" y="144" fill="#E5A03D" font-family="Sora, PingFang SC, sans-serif" font-size="11.5">{zh ? "澄清 → 拆分 → 独立评审 → 持久续跑" : "Clarify → Build → Verify → Persist"}</text>
</svg>

<style>
  .uc-svg-diagram {
    width: 100%;
    height: auto;
    display: block;
  }
</style>
