---
interface Props {
  lang?: "zh" | "en";
}
const { lang = "zh" } = Astro.props;
const zh = lang === "zh";
---

<svg viewBox="0 0 920 156" fill="none" xmlns="http://www.w3.org/2000/svg" class="uc-svg-diagram" role="img" aria-label={zh ? "Prompt、Context、Goal 三代工程演进图" : "Evolution from Prompt to Context to Goal Engineering"}>
  <line x1="0" y1="0.5" x2="920" y2="0.5" stroke="rgba(255,255,255,0.08)"/>
  <line x1="0" y1="155.5" x2="920" y2="155.5" stroke="rgba(255,255,255,0.08)"/>
  <line x1="306.5" y1="0" x2="306.5" y2="156" stroke="rgba(255,255,255,0.08)"/>
  <line x1="613.5" y1="0" x2="613.5" y2="156" stroke="rgba(255,255,255,0.08)"/>
  <line x1="614" y1="0.5" x2="920" y2="0.5" stroke="#BAE6FD" stroke-width="1.6"/>

  <text x="20" y="52" fill="#A3A3A3" font-family="Sora, PingFang SC, sans-serif" font-size="17" font-weight="500">Prompt Engineering</text>
  <text x="20" y="88" fill="#737373" font-family="Sora, PingFang SC, sans-serif" font-size="12.5">{zh ? "反复打磨单句提示词" : "Polishing one-shot prompts"}</text>
  <text x="20" y="118" fill="#525252" font-family="Sora, PingFang SC, sans-serif" font-size="12">{zh ? "任务一长就失忆、跑偏" : "Breaks on multi-step work"}</text>

  <text x="328" y="52" fill="#D4D4D4" font-family="Sora, PingFang SC, sans-serif" font-size="17" font-weight="500">Context Engineering</text>
  <text x="328" y="88" fill="#8A8A8A" font-family="Sora, PingFang SC, sans-serif" font-size="12.5">{zh ? "给模型喂对文档、工具与记忆" : "Curating right docs & memory"}</text>
  <text x="328" y="118" fill="#636363" font-family="Sora, PingFang SC, sans-serif" font-size="12">{zh ? "看懂了却仍会偷懒或自评过关" : "Still drifts or self-approves"}</text>

  <text x="636" y="52" fill="#FFFFFF" font-family="Sora, PingFang SC, sans-serif" font-size="17" font-weight="500">{zh ? "Goal Engineering 目标工程" : "Goal Engineering"}</text>
  <text x="636" y="88" fill="#D4D4D4" font-family="Sora, PingFang SC, sans-serif" font-size="12.5">{zh ? "以可验证的最终目标驱动全程" : "Outcome-driven autonomous delivery"}</text>
  <text x="636" y="118" fill="#BAE6FD" font-family="Sora, PingFang SC, sans-serif" font-size="12">{zh ? "澄清 → 拆分 → 独立评审 → 持久续跑" : "Clarify → Build → Verify → Persist"}</text>
</svg>

<style>
  .uc-svg-diagram {
    width: 100%;
    height: auto;
    display: block;
  }
</style>
