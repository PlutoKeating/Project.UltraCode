---
import { DIAGRAMS_COPY, type Locale } from "../../i18n/ui";

interface Props {
  lang?: Locale;
}
const { lang = "en" } = Astro.props;
const t = DIAGRAMS_COPY[lang].eras;
---

<div class="uc-grid-3" role="group" aria-label={t.aria}>
  <div class="uc-cell">
    <h3>{t.p1Title}</h3>
    <p>{t.p1Sub}</p>
    <p class="uc-muted">{t.p1Muted}</p>
  </div>
  <div class="uc-cell">
    <h3>{t.p2Title}</h3>
    <p>{t.p2Sub}</p>
    <p class="uc-muted">{t.p2Muted}</p>
  </div>
  <div class="uc-cell is-accent">
    <h3>{t.p3Title}</h3>
    <p>{t.p3Sub}</p>
    <p class="uc-ice">{t.p3Ice}</p>
  </div>
</div>

<style>
  .uc-grid-3 {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    text-align: start;
  }

  .uc-cell {
    padding: 1.5rem 1.35rem;
    border-inline-end: 1px solid rgba(255, 255, 255, 0.08);
    margin: 0 !important;
  }

  .uc-cell:last-child {
    border-inline-end: none;
  }

  .uc-cell.is-accent {
    border-top: 1.5px solid #bae6fd;
    margin-top: -1px !important;
  }

  .uc-cell h3 {
    margin: 0 0 0.7rem !important;
    font-size: 1.05rem !important;
    font-weight: 500 !important;
    color: #ffffff !important;
    line-height: 1.35 !important;
  }

  .uc-cell p {
    margin: 0.4rem 0 0 !important;
    font-size: 0.92rem !important;
    line-height: 1.6 !important;
    color: #cccccc !important;
  }

  .uc-cell p.uc-muted {
    color: #8f8f8f !important;
  }

  .uc-cell p.uc-ice {
    color: #bae6fd !important;
  }

  @media (max-width: 760px) {
    .uc-grid-3 {
      grid-template-columns: 1fr;
    }

    .uc-cell {
      border-inline-end: none;
      border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    }

    .uc-cell:last-child {
      border-bottom: none;
    }
  }
</style>
