---
interface Props {
  lang?: "zh" | "en";
}
const { lang = "zh" } = Astro.props;
const zh = lang === "zh";
---

<div class="uc-grid-3" role="group" aria-label={zh ? "Prompt、Context、Goal 三代工程演进" : "Prompt, Context, and Goal Engineering evolution"}>
  <div class="uc-cell">
    <h3>Prompt Engineering</h3>
    <p>{zh ? "反复打磨单句提示词" : "Polishing one-shot prompts"}</p>
    <p class="uc-muted">{zh ? "任务一长就失忆、跑偏" : "Breaks on multi-step work"}</p>
  </div>
  <div class="uc-cell">
    <h3>Context Engineering</h3>
    <p>{zh ? "给模型喂对文档、工具与记忆" : "Curating right docs & memory"}</p>
    <p class="uc-muted">{zh ? "看懂了却仍会偷懒或自评过关" : "Still drifts or self-approves"}</p>
  </div>
  <div class="uc-cell is-accent">
    <h3>{zh ? "Goal Engineering 目标工程" : "Goal Engineering"}</h3>
    <p>{zh ? "以可验证的最终目标驱动全程" : "Outcome-driven autonomous delivery"}</p>
    <p class="uc-ice">{zh ? "澄清 → 拆分 → 独立评审 → 持久续跑" : "Clarify → Build → Verify → Persist"}</p>
  </div>
</div>

<style>
  .uc-grid-3 {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    text-align: left;
  }

  .uc-cell {
    padding: 1.5rem 1.35rem;
    border-right: 1px solid rgba(255, 255, 255, 0.08);
    margin: 0 !important;
  }

  .uc-cell:last-child {
    border-right: none;
  }

  .uc-cell.is-accent {
    border-top: 1.5px solid #bae6fd;
    margin-top: -1px !important;
  }

  .uc-cell h3 {
    margin: 0 0 0.7rem !important;
    font-size: 1.05rem !important;
    font-weight: 500 !important;
    color: #ffffff !important;
    line-height: 1.35 !important;
  }

  .uc-cell p {
    margin: 0.4rem 0 0 !important;
    font-size: 0.92rem !important;
    line-height: 1.6 !important;
    color: #cccccc !important;
  }

  .uc-cell p.uc-muted {
    color: #8f8f8f !important;
  }

  .uc-cell p.uc-ice {
    color: #bae6fd !important;
  }

  @media (max-width: 760px) {
    .uc-grid-3 {
      grid-template-columns: 1fr;
    }

    .uc-cell {
      border-right: none;
      border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    }

    .uc-cell:last-child {
      border-bottom: none;
    }
  }
</style>
