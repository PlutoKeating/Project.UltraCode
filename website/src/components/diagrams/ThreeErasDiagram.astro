---
interface Props {
  lang?: "zh" | "en";
}
const { lang = "zh" } = Astro.props;
const zh = lang === "zh";
---

<svg viewBox="0 0 920 220" fill="none" xmlns="http://www.w3.org/2000/svg" class="uc-svg-diagram" role="img" aria-label={zh ? "Prompt、Context、Goal 三代工程演进图" : "Evolution from Prompt to Context to Goal Engineering"}>
  <rect x="0.5" y="0.5" width="919" height="219" rx="10" fill="#0A0A0A" stroke="rgba(255,255,255,0.09)"/>

  <!-- Stage 1 -->
  <rect x="28" y="34" width="252" height="152" rx="8" fill="#111111" stroke="rgba(255,255,255,0.08)"/>
  <text x="48" y="64" fill="#737373" font-family="JetBrains Mono, monospace" font-size="11">GEN 01</text>
  <text x="48" y="92" fill="#D4D4D4" font-family="Sora, PingFang SC, sans-serif" font-size="17" font-weight="600">
    Prompt Engineering
  </text>
  <text x="48" y="122" fill="#A3A3A3" font-family="Sora, PingFang SC, sans-serif" font-size="13">
    {zh ? "反复打磨单句提示词" : "Polishing one-shot prompts"}
  </text>
  <text x="48" y="148" fill="#737373" font-family="Sora, PingFang SC, sans-serif" font-size="12">
    {zh ? "局限：任务一长就失忆、跑偏" : "Limit: breaks on multi-step work"}
  </text>

  <!-- Arrow 1 -->
  <path d="M 292 110 L 322 110 M 316 104 L 322 110 L 316 116" stroke="rgba(255,255,255,0.28)" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>

  <!-- Stage 2 -->
  <rect x="334" y="34" width="252" height="152" rx="8" fill="#111111" stroke="rgba(255,255,255,0.10)"/>
  <text x="354" y="64" fill="#A3A3A3" font-family="JetBrains Mono, monospace" font-size="11">GEN 02</text>
  <text x="354" y="92" fill="#E5E5E5" font-family="Sora, PingFang SC, sans-serif" font-size="17" font-weight="600">
    Context Engineering
  </text>
  <text x="354" y="122" fill="#A3A3A3" font-family="Sora, PingFang SC, sans-serif" font-size="13">
    {zh ? "给模型喂对文档、工具与记忆" : "Curating right docs & memory"}
  </text>
  <text x="354" y="148" fill="#737373" font-family="Sora, PingFang SC, sans-serif" font-size="12">
    {zh ? "局限：看懂了却仍会偷懒或自评过关" : "Limit: still drifts or self-approves"}
  </text>

  <!-- Arrow 2 -->
  <path d="M 598 110 L 628 110 M 622 104 L 628 110 L 622 116" stroke="#22D3EE" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>

  <!-- Stage 3: Goal Engineering -->
  <rect x="640" y="34" width="252" height="152" rx="8" fill="rgba(34,211,238,0.06)" stroke="rgba(34,211,238,0.42)"/>
  <text x="660" y="64" fill="#22D3EE" font-family="JetBrains Mono, monospace" font-size="11">GEN 03 · ULTRACODE</text>
  <text x="660" y="92" fill="#F5F5F5" font-family="Sora, PingFang SC, sans-serif" font-size="17" font-weight="700">
    {zh ? "Goal Engineering 目标工程" : "Goal Engineering"}
  </text>
  <text x="660" y="122" fill="#E0E0E0" font-family="Sora, PingFang SC, sans-serif" font-size="13">
    {zh ? "以可验证的最终目标驱动全程" : "Outcome-driven autonomous delivery"}
  </text>
  <text x="660" y="148" fill="#22D3EE" font-family="Sora, PingFang SC, sans-serif" font-size="12">
    {zh ? "澄清 → 拆分 → 独立评审 → 持久续跑" : "Clarify → Build → Verify → Persist"}
  </text>
</svg>

<style>
  .uc-svg-diagram {
    width: 100%;
    height: auto;
    display: block;
  }
</style>
