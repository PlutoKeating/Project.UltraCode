---
import { DIAGRAMS_COPY, type Locale } from "../../i18n/ui";

interface Props {
  lang?: Locale;
}
const { lang = "en" } = Astro.props;
const t = DIAGRAMS_COPY[lang].minimal;
---

<div class="uc-grid-4" role="group" aria-label={t.aria}>
  <div class="uc-step">
    <span class="uc-num">01</span>
    <h3>{t.s1Title}</h3>
    <p>{t.s1Sub}</p>
  </div>
  <div class="uc-step">
    <span class="uc-num is-amber">02</span>
    <h3>{t.s2Title}</h3>
    <p>{t.s2Sub}</p>
  </div>
  <div class="uc-step">
    <span class="uc-num">03</span>
    <h3>{t.s3Title}</h3>
    <p>{t.s3Sub}</p>
  </div>
  <div class="uc-step is-accent">
    <span class="uc-num is-ice">04</span>
    <h3>{t.s4Title}</h3>
    <p>{t.s4Sub}</p>
  </div>
</div>

<style>
  .uc-grid-4 {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    text-align: start;
  }

  .uc-step {
    padding: 1.5rem 1.25rem;
    border-inline-end: 1px solid rgba(255, 255, 255, 0.08);
  }

  .uc-step:last-child {
    border-inline-end: none;
  }

  .uc-step.is-accent {
    border-top: 1.5px solid #bae6fd;
    margin-top: -1px;
  }

  .uc-num {
    display: block;
    font-family: var(--uc-font-mono);
    font-size: 0.82rem;
    color: #8a8a8a;
    margin-bottom: 0.65rem;
  }

  .uc-num.is-amber {
    color: #e5a03d;
  }

  .uc-num.is-ice {
    color: #bae6fd;
  }

  .uc-step h3 {
    margin: 0 0 0.6rem !important;
    font-size: 1.05rem !important;
    font-weight: 500 !important;
    color: #ffffff !important;
    line-height: 1.35 !important;
  }

  .uc-step p {
    margin: 0 !important;
    font-size: 0.9rem !important;
    line-height: 1.65 !important;
    color: #b5b5b5 !important;
  }

  @media (max-width: 820px) {
    .uc-grid-4 {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .uc-step:nth-child(2n) {
      border-inline-end: none;
    }

    .uc-step:nth-child(-n + 2) {
      border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    }
  }

  @media (max-width: 540px) {
    .uc-grid-4 {
      grid-template-columns: 1fr;
    }

    .uc-step {
      border-inline-end: none;
      border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    }

    .uc-step:last-child {
      border-bottom: none;
    }
  }
</style>
