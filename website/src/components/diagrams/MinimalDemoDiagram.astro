---
interface Props {
  lang?: "zh" | "en";
}
const { lang = "zh" } = Astro.props;
const zh = lang === "zh";
---

<svg viewBox="0 0 960 156" fill="none" xmlns="http://www.w3.org/2000/svg" class="uc-svg-diagram" role="img" aria-label={zh ? "1 分钟最小上手体验 4 步精密导轨" : "4-step minimal onboarding architectural rail"}>
  <line x1="0" y1="0.5" x2="960" y2="0.5" stroke="rgba(255,255,255,0.09)"/>
  <line x1="0" y1="155.5" x2="960" y2="155.5" stroke="rgba(255,255,255,0.09)"/>
  <line x1="240.5" y1="0" x2="240.5" y2="156" stroke="rgba(255,255,255,0.08)"/>
  <line x1="480.5" y1="0" x2="480.5" y2="156" stroke="rgba(255,255,255,0.08)"/>
  <line x1="720.5" y1="0" x2="720.5" y2="156" stroke="rgba(255,255,255,0.08)"/>
  <line x1="721" y1="0.5" x2="960" y2="0.5" stroke="#BAE6FD" stroke-width="1.5"/>

  <text x="20" y="38" fill="#666666" font-family="JetBrains Mono, monospace" font-size="11">01</text>
  <text x="20" y="74" fill="#FFFFFF" font-family="Sora, PingFang SC, sans-serif" font-size="16" font-weight="500">{zh ? "一句话说出目标" : "State Your Goal"}</text>
  <text x="20" y="108" fill="#8A8A8A" font-family="Sora, PingFang SC, sans-serif" font-size="12.5">{zh ? "任意空目录运行 opencode" : "Run opencode anywhere"}</text>
  <text x="20" y="130" fill="#8A8A8A" font-family="Sora, PingFang SC, sans-serif" font-size="12.5">{zh ? "直接说出想要的结果" : "Describe what you want"}</text>

  <text x="260" y="38" fill="#E5A03D" font-family="JetBrains Mono, monospace" font-size="11">02</text>
  <text x="260" y="74" fill="#FFFFFF" font-family="Sora, PingFang SC, sans-serif" font-size="16" font-weight="500">{zh ? "收到一次性选择题" : "Answer Choice Cards"}</text>
  <text x="260" y="108" fill="#8A8A8A" font-family="Sora, PingFang SC, sans-serif" font-size="12.5">{zh ? "先调研，把所有关键分歧" : "Researches first, batches"}</text>
  <text x="260" y="130" fill="#8A8A8A" font-family="Sora, PingFang SC, sans-serif" font-size="12.5">{zh ? "一次问齐，每题带推荐项" : "key trade-offs once"}</text>

  <text x="500" y="38" fill="#666666" font-family="JetBrains Mono, monospace" font-size="11">03</text>
  <text x="500" y="74" fill="#FFFFFF" font-family="Sora, PingFang SC, sans-serif" font-size="16" font-weight="500">{zh ? "后台专家分工实现" : "Experts Build It"}</text>
  <text x="500" y="108" fill="#8A8A8A" font-family="Sora, PingFang SC, sans-serif" font-size="12.5">{zh ? "主控自动拆解里程碑" : "Orchestrator delegates"}</text>
  <text x="500" y="130" fill="#8A8A8A" font-family="Sora, PingFang SC, sans-serif" font-size="12.5">{zh ? "并行编码并触发独立评审" : "build & skeptical audit"}</text>

  <text x="740" y="38" fill="#BAE6FD" font-family="JetBrains Mono, monospace" font-size="11">04</text>
  <text x="740" y="74" fill="#FFFFFF" font-family="Sora, PingFang SC, sans-serif" font-size="16" font-weight="500">{zh ? "真机浏览器目视交付" : "Real-Browser QA"}</text>
  <text x="740" y="108" fill="#A3A3A3" font-family="Sora, PingFang SC, sans-serif" font-size="12.5">{zh ? "亲自打开真实浏览器截屏" : "Opens real Chromium,"}</text>
  <text x="740" y="130" fill="#A3A3A3" font-family="Sora, PingFang SC, sans-serif" font-size="12.5">{zh ? "修完排版错位再汇报完工" : "fixes layout before finish"}</text>
</svg>

<style>
  .uc-svg-diagram {
    width: 100%;
    height: auto;
    display: block;
  }
</style>
