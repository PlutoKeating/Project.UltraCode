---
interface Props {
  lang?: "zh" | "en";
}
const { lang = "zh" } = Astro.props;
const zh = lang === "zh";
---

<div class="uc-grid-4" role="group" aria-label={zh ? "1 分钟最小上手体验 4 步导轨" : "4-step minimal onboarding rail"}>
  <div class="uc-step">
    <span class="uc-num">01</span>
    <h3>{zh ? "一句话说出目标" : "State Your Goal"}</h3>
    <p>{zh ? "任意空目录运行 ultracode，直接说出想要的结果。" : "Run ultracode anywhere and describe the outcome."}</p>
  </div>
  <div class="uc-step">
    <span class="uc-num is-amber">02</span>
    <h3>{zh ? "收到一次性选择题" : "Answer Choice Cards"}</h3>
    <p>{zh ? "先调研，把关键分歧一次问齐，每题自带推荐项。" : "Researches first and batches key trade-offs once."}</p>
  </div>
  <div class="uc-step">
    <span class="uc-num">03</span>
    <h3>{zh ? "后台专家分工实现" : "Experts Build It"}</h3>
    <p>{zh ? "主控拆解里程碑，后台并行编码并触发独立评审。" : "Orchestrator delegates build and skeptical audit."}</p>
  </div>
  <div class="uc-step is-accent">
    <span class="uc-num is-ice">04</span>
    <h3>{zh ? "真机浏览器目视交付" : "Real-Browser QA"}</h3>
    <p>{zh ? "亲自打开真实浏览器截屏，修完排版错位再汇报完工。" : "Opens real Chromium and fixes layout before finish."}</p>
  </div>
</div>

<style>
  .uc-grid-4 {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    text-align: left;
  }

  .uc-step {
    padding: 1.5rem 1.25rem;
    border-right: 1px solid rgba(255, 255, 255, 0.08);
  }

  .uc-step:last-child {
    border-right: none;
  }

  .uc-step.is-accent {
    border-top: 1.5px solid #bae6fd;
    margin-top: -1px;
  }

  .uc-num {
    display: block;
    font-family: var(--uc-font-mono);
    font-size: 0.82rem;
    color: #8a8a8a;
    margin-bottom: 0.65rem;
  }

  .uc-num.is-amber {
    color: #e5a03d;
  }

  .uc-num.is-ice {
    color: #bae6fd;
  }

  .uc-step h3 {
    margin: 0 0 0.6rem !important;
    font-size: 1.05rem !important;
    font-weight: 500 !important;
    color: #ffffff !important;
    line-height: 1.35 !important;
  }

  .uc-step p {
    margin: 0 !important;
    font-size: 0.9rem !important;
    line-height: 1.65 !important;
    color: #b5b5b5 !important;
  }

  @media (max-width: 820px) {
    .uc-grid-4 {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .uc-step:nth-child(2n) {
      border-right: none;
    }

    .uc-step:nth-child(-n + 2) {
      border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    }
  }

  @media (max-width: 540px) {
    .uc-grid-4 {
      grid-template-columns: 1fr;
    }

    .uc-step {
      border-right: none;
      border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    }

    .uc-step:last-child {
      border-bottom: none;
    }
  }
</style>
