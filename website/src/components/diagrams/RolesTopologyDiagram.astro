---
import { DIAGRAMS_COPY, svgBidi, type Locale } from "../../i18n/ui";

interface Props {
  lang?: Locale;
}
const { lang = "en" } = Astro.props;
const t = DIAGRAMS_COPY[lang].roles;
---

<svg viewBox="0 0 760 280" fill="none" xmlns="http://www.w3.org/2000/svg" class="uc-svg-diagram" role="img" aria-label={t.aria}>
  <line x1="0" y1="0.5" x2="760" y2="0.5" stroke="rgba(255,255,255,0.08)"/>
  <line x1="0" y1="279.5" x2="760" y2="279.5" stroke="rgba(255,255,255,0.08)"/>

  <line x1="24" y1="24" x2="318" y2="24" stroke="#BAE6FD" stroke-width="1.8"/>
  <rect x="24" y="24" width="294" height="78" fill="rgba(255,255,255,0.03)" stroke="rgba(255,255,255,0.14)"/>
  <text x="44" y="55" fill="#FFFFFF" font-family="var(--uc-font-mono)" font-size="16.5" font-weight="500">UltraBuild</text>
  <text x="44" y="83" fill="#C4C4C4" font-family="var(--uc-font-sans)" font-size="13.5">{svgBidi(lang, t.buildSub)}</text>

  <line x1="318" y1="63" x2="442" y2="63" stroke="rgba(255,255,255,0.24)" stroke-dasharray="4 4"/>
  <rect x="334" y="47" width="92" height="32" fill="#000000" stroke="rgba(255,255,255,0.22)"/>
  <text x="380" y="68" text-anchor="middle" fill="#FFFFFF" font-family="var(--uc-font-mono)" font-size="13">Shift+Tab</text>

  <rect x="442" y="24" width="294" height="78" fill="transparent" stroke="rgba(255,255,255,0.12)"/>
  <text x="462" y="55" fill="#E5E5E5" font-family="var(--uc-font-mono)" font-size="16.5" font-weight="500">UltraPlan</text>
  <text x="462" y="83" fill="#B0B0B0" font-family="var(--uc-font-sans)" font-size="13.5">{svgBidi(lang, t.planSub)}</text>

  <line x1="171" y1="102" x2="171" y2="146" stroke="rgba(255,255,255,0.36)" stroke-width="1.4"/>
  <line x1="76" y1="146" x2="684" y2="146" stroke="rgba(255,255,255,0.18)" stroke-width="1.4"/>
  <line x1="76" y1="146" x2="76" y2="178" stroke="rgba(255,255,255,0.22)"/>
  <line x1="228" y1="146" x2="228" y2="178" stroke="rgba(255,255,255,0.22)"/>
  <line x1="380" y1="146" x2="380" y2="178" stroke="rgba(255,255,255,0.22)"/>
  <line x1="532" y1="146" x2="532" y2="178" stroke="rgba(255,255,255,0.22)"/>
  <line x1="684" y1="146" x2="684" y2="178" stroke="#BAE6FD" stroke-width="1.4"/>

  <circle cx="76" cy="178" r="4" fill="#B5B5B5"/>
  <circle cx="228" cy="178" r="4" fill="#B5B5B5"/>
  <circle cx="380" cy="178" r="4" fill="#FFFFFF"/>
  <circle cx="532" cy="178" r="4" fill="#E5A03D"/>
  <circle cx="684" cy="178" r="4.5" fill="#BAE6FD"/>

  <g font-family="var(--uc-font-sans)" text-anchor="middle">
    <text x="76" y="216" fill="#FFFFFF" font-size="15.5" font-weight="500">{svgBidi(lang, t.r1Title)}</text>
    <text x="76" y="244" fill="#B5B5B5" font-size="13">{svgBidi(lang, t.r1Sub)}</text>

    <text x="228" y="216" fill="#FFFFFF" font-size="15.5" font-weight="500">{svgBidi(lang, t.r2Title)}</text>
    <text x="228" y="244" fill="#B5B5B5" font-size="13">{svgBidi(lang, t.r2Sub)}</text>

    <text x="380" y="216" fill="#FFFFFF" font-size="15.5" font-weight="500">{svgBidi(lang, t.r3Title)}</text>
    <text x="380" y="244" fill="#C4C4C4" font-size="13">{svgBidi(lang, t.r3Sub)}</text>

    <text x="532" y="216" fill="#FFFFFF" font-size="15.5" font-weight="500">{svgBidi(lang, t.r4Title)}</text>
    <text x="532" y="244" fill="#E5A03D" font-size="13">{svgBidi(lang, t.r4Sub)}</text>

    <text x="684" y="216" fill="#BAE6FD" font-size="15.5" font-weight="500">{svgBidi(lang, t.r5Title)}</text>
    <text x="684" y="244" fill="#E0E0E0" font-size="13">{svgBidi(lang, t.r5Sub)}</text>
  </g>
</svg>

<style>
  .uc-svg-diagram {
    width: 100%;
    height: auto;
    display: block;
    direction: ltr;
  }
</style>
