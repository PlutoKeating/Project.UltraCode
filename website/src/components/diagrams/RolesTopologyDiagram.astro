---
interface Props {
  lang?: "zh" | "en";
}
const { lang = "zh" } = Astro.props;
const zh = lang === "zh";
---

<svg viewBox="0 0 960 296" fill="none" xmlns="http://www.w3.org/2000/svg" class="uc-svg-diagram" role="img" aria-label={zh ? "UltraBuild 与 UltraPlan 双主角色及 5 位后台专家协作拓扑图" : "UltraBuild and UltraPlan primary roles plus 5 background experts topology"}>
  <line x1="0" y1="0.5" x2="960" y2="0.5" stroke="rgba(255,255,255,0.08)"/>
  <line x1="0" y1="295.5" x2="960" y2="295.5" stroke="rgba(255,255,255,0.08)"/>

  <!-- Primary roles -->
  <line x1="72" y1="28" x2="412" y2="28" stroke="#BAE6FD" stroke-width="1.8"/>
  <rect x="72" y="28" width="340" height="82" fill="rgba(255,255,255,0.03)" stroke="rgba(255,255,255,0.14)"/>
  <text x="96" y="61" fill="#FFFFFF" font-family="JetBrains Mono, monospace" font-size="17" font-weight="500">UltraBuild</text>
  <text x="96" y="90" fill="#B5B5B5" font-family="Sora, PingFang SC, sans-serif" font-size="14.5">{zh ? "默认总控 · 协调、执行与交付" : "Default · orchestrate, build & verify"}</text>

  <line x1="412" y1="69" x2="548" y2="69" stroke="rgba(255,255,255,0.24)" stroke-dasharray="4 4"/>
  <rect x="434" y="52" width="92" height="34" fill="#000000" stroke="rgba(255,255,255,0.22)"/>
  <text x="480" y="74" text-anchor="middle" fill="#E5E5E5" font-family="JetBrains Mono, monospace" font-size="13">Shift+Tab</text>

  <rect x="548" y="28" width="340" height="82" fill="transparent" stroke="rgba(255,255,255,0.12)"/>
  <text x="572" y="61" fill="#E5E5E5" font-family="JetBrains Mono, monospace" font-size="17" font-weight="500">UltraPlan</text>
  <text x="572" y="90" fill="#A3A3A3" font-family="Sora, PingFang SC, sans-serif" font-size="14.5">{zh ? "只读规划 · 推演方案不改代码" : "Read-only planning without code edits"}</text>

  <!-- Bus trunk & 5 branches -->
  <line x1="242" y1="110" x2="242" y2="156" stroke="rgba(255,255,255,0.36)" stroke-width="1.4"/>
  <line x1="96" y1="156" x2="864" y2="156" stroke="rgba(255,255,255,0.18)" stroke-width="1.4"/>
  <line x1="96" y1="156" x2="96" y2="190" stroke="rgba(255,255,255,0.2)"/>
  <line x1="288" y1="156" x2="288" y2="190" stroke="rgba(255,255,255,0.2)"/>
  <line x1="480" y1="156" x2="480" y2="190" stroke="rgba(255,255,255,0.2)"/>
  <line x1="672" y1="156" x2="672" y2="190" stroke="rgba(255,255,255,0.2)"/>
  <line x1="864" y1="156" x2="864" y2="190" stroke="#BAE6FD" stroke-width="1.4"/>

  <circle cx="96" cy="190" r="4" fill="#A3A3A3"/>
  <circle cx="288" cy="190" r="4" fill="#A3A3A3"/>
  <circle cx="480" cy="190" r="4" fill="#FFFFFF"/>
  <circle cx="672" cy="190" r="4" fill="#E5A03D"/>
  <circle cx="864" cy="190" r="4.5" fill="#BAE6FD"/>

  <g font-family="Sora, PingFang SC, sans-serif" text-anchor="middle">
    <text x="96" y="228" fill="#FFFFFF" font-size="17" font-weight="500">{zh ? "调研专家" : "Librarian"}</text>
    <text x="96" y="258" fill="#A8A8A8" font-size="14">{zh ? "查官方文档与开源" : "Docs & OSS research"}</text>

    <text x="288" y="228" fill="#FFFFFF" font-size="17" font-weight="500">{zh ? "架构专家" : "Architect"}</text>
    <text x="288" y="258" fill="#A8A8A8" font-size="14">{zh ? "方案权衡与根因" : "Design & root cause"}</text>

    <text x="480" y="228" fill="#FFFFFF" font-size="17" font-weight="500">{zh ? "实施专家" : "Implementer"}</text>
    <text x="480" y="258" fill="#B5B5B5" font-size="14">{zh ? "专注单项落地验证" : "Bounded verified build"}</text>

    <text x="672" y="228" fill="#FFFFFF" font-size="17" font-weight="500">{zh ? "挑刺评审" : "Reviewer"}</text>
    <text x="672" y="258" fill="#E5A03D" font-size="14">{zh ? "独立查漏防回归" : "Skeptical code audit"}</text>

    <text x="864" y="228" fill="#BAE6FD" font-size="17" font-weight="500">{zh ? "视觉验收" : "Visual QA"}</text>
    <text x="864" y="258" fill="#D4D4D4" font-size="14">{zh ? "真机浏览器目视实测" : "Real Chromium checks"}</text>
  </g>
</svg>

<style>
  .uc-svg-diagram {
    width: 100%;
    height: auto;
    display: block;
  }
</style>
