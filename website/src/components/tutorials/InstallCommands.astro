---
export interface Props {
  unixLabel?: string;
  windowsLabel?: string;
  unixHint?: string;
  windowsHint?: string;
  unixCommand: string;
  windowsCommand: string;
  copyLabel?: string;
  copiedLabel?: string;
}

const {
  unixLabel = "macOS / Linux",
  windowsLabel = "Windows",
  unixHint,
  windowsHint,
  unixCommand,
  windowsCommand,
  copyLabel = "Copy",
  copiedLabel = "Copied",
} = Astro.props;

const options = [
  { label: unixLabel, hint: unixHint, command: unixCommand },
  { label: windowsLabel, hint: windowsHint, command: windowsCommand },
];
---

<div class="uc-install-options not-content">
  {
    options.map((option) => (
      <div class="uc-install-option">
        <div class="uc-install-head">
          <div class="uc-install-meta">
            <span class="uc-install-os">{option.label}</span>
            {option.hint && <span class="uc-install-hint">{option.hint}</span>}
          </div>
          <button
            type="button"
            class="uc-install-copy"
            data-uc-copy={option.command}
            data-label-default={copyLabel}
            data-label-copied={copiedLabel}
          >
            <svg width="13" height="13" viewBox="0 0 16 16" fill="none" aria-hidden="true">
              <rect x="5.5" y="5.5" width="8" height="8" rx="1.5" stroke="currentColor" stroke-width="1.3" />
              <path
                d="M3.5 10.5H3a1.5 1.5 0 0 1-1.5-1.5V3A1.5 1.5 0 0 1 3 1.5h6A1.5 1.5 0 0 1 10.5 3v.5"
                stroke="currentColor"
                stroke-width="1.3"
              />
            </svg>
            <span class="uc-copy-text">{copyLabel}</span>
          </button>
        </div>
        <div class="uc-install-command" dir="ltr">
          <code>{option.command}</code>
        </div>
      </div>
    ))
  }
</div>

<script>
  function bindInstallCopyButtons() {
    document.querySelectorAll<HTMLButtonElement>("button[data-uc-copy]").forEach((btn) => {
      if (btn.dataset.bound === "1") return;
      btn.dataset.bound = "1";
      btn.addEventListener("click", async () => {
        const text = btn.dataset.ucCopy ?? "";
        const label = btn.querySelector<HTMLElement>(".uc-copy-text");
        const def = btn.dataset.labelDefault ?? "Copy";
        const done = btn.dataset.labelCopied ?? "Copied";
        try {
          await navigator.clipboard.writeText(text);
          btn.classList.add("is-copied");
          if (label) label.textContent = done;
          window.setTimeout(() => {
            btn.classList.remove("is-copied");
            if (label) label.textContent = def;
          }, 1600);
        } catch {
          // Clipboard permission fallback
        }
      });
    });
  }

  bindInstallCopyButtons();
  document.addEventListener("astro:page-load", bindInstallCopyButtons);
</script>

<style>
  .uc-install-options {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    margin: 0.9rem 0 0.2rem;
  }

  .uc-install-option {
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 8px;
    background: #0a0a0a;
    padding: 0.75rem 0.9rem 0.8rem;
  }

  .uc-install-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    margin-bottom: 0.5rem;
  }

  .uc-install-meta {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    flex-wrap: wrap;
    min-width: 0;
  }

  .uc-install-os {
    font-family: var(--uc-font-mono);
    font-size: 0.9em;
    color: #ffffff;
    letter-spacing: 0.01em;
  }

  .uc-install-hint {
    font-size: 0.82em;
    color: #8a8a8a;
  }

  .uc-install-command {
    padding: 0.55rem 0.65rem;
    border-radius: 6px;
    background: #050505;
    border: 1px solid rgba(255, 255, 255, 0.07);
  }

  .uc-install-command code {
    display: block;
    font-family: var(--uc-font-mono);
    font-size: 0.82em;
    line-height: 1.55;
    color: #e5e5e5;
    background: none;
    border: none;
    padding: 0;
    white-space: normal;
    overflow-wrap: anywhere;
  }

  .uc-install-copy {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    flex-shrink: 0;
    padding: 0.3em 0.6em;
    border-radius: 5px;
    border: 1px solid rgba(255, 255, 255, 0.14);
    background: #141414;
    color: #e5e5e5;
    font-family: var(--uc-font-sans);
    font-size: 0.78em;
    font-weight: 500;
    cursor: pointer;
    transition: background 140ms ease, color 140ms ease, border-color 140ms ease;
  }

  .uc-install-copy:hover {
    background: #ffffff;
    border-color: #ffffff;
    color: #000000;
  }

  .uc-install-copy:focus-visible {
    outline: 2px solid #bae6fd;
    outline-offset: 2px;
  }

  .uc-install-copy.is-copied {
    border-color: #bae6fd;
    color: #bae6fd;
    background: rgba(186, 230, 253, 0.08);
  }

  .uc-install-copy svg {
    width: 1em;
    height: 1em;
  }

  @media (max-width: 480px) {
    .uc-install-option {
      padding: 0.7rem 0.75rem;
    }

    .uc-install-head {
      align-items: flex-start;
      gap: 0.5rem;
    }

    .uc-install-copy {
      margin-top: -0.1rem;
    }
  }
</style>
