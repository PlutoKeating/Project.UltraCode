---
export interface Props {
  step: number;
  title: string;
  promptLabel?: string;
  promptText?: string;
  isCommand?: boolean;
  copyLabel?: string;
  copiedLabel?: string;
  expectLabel?: string;
  expectText?: string;
}

const {
  step,
  title,
  promptLabel,
  promptText,
  isCommand = false,
  copyLabel = "Copy",
  copiedLabel = "Copied",
  expectLabel = "What you'll see",
  expectText,
} = Astro.props;
---

<section class="uc-tstep" aria-labelledby={`uc-step-${step}`}>
  <div class="uc-tstep-head not-content">
    <span class="uc-tstep-num">{String(step).padStart(2, "0")}</span>
    <h2 id={`uc-step-${step}`} class="uc-tstep-title">{title}</h2>
  </div>

  <div class="uc-tstep-body">
    <slot />
  </div>

  {
    promptText && (
      <div class="uc-tstep-prompt-wrap not-content">
        {promptLabel && <p class="uc-tstep-prompt-label">{promptLabel}</p>}
        <div class="uc-tstep-prompt-box" dir={isCommand ? "ltr" : undefined}>
          <span class:list={["uc-tstep-prompt-text", { "is-mono": isCommand }]}>{promptText}</span>
          <button
            type="button"
            class="uc-tstep-copy-btn"
            data-uc-copy={promptText}
            data-label-default={copyLabel}
            data-label-copied={copiedLabel}
          >
            <svg class="uc-icon-copy" width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true">
              <rect x="5.5" y="5.5" width="8" height="8" rx="1.5" stroke="currentColor" stroke-width="1.3" />
              <path
                d="M3.5 10.5H3a1.5 1.5 0 0 1-1.5-1.5V3A1.5 1.5 0 0 1 3 1.5h6A1.5 1.5 0 0 1 10.5 3v.5"
                stroke="currentColor"
                stroke-width="1.3"
              />
            </svg>
            <span class="uc-copy-text">{copyLabel}</span>
          </button>
        </div>
      </div>
    )
  }

  {
    expectText && (
      <div class="uc-tstep-expect not-content">
        <svg class="uc-expect-icon" width="15" height="15" viewBox="0 0 16 16" fill="none" aria-hidden="true">
          <circle cx="8" cy="8" r="6.5" stroke="#bae6fd" stroke-width="1.3" />
          <path d="M5.2 8.2L7.1 10.1L10.9 6.1" stroke="#bae6fd" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
        <p class="uc-expect-copy">
          <strong>{expectLabel}:</strong> {expectText}
        </p>
      </div>
    )
  }
</section>

<script>
  function bindTutorialCopyButtons() {
    const buttons = document.querySelectorAll<HTMLButtonElement>("button[data-uc-copy]");
    buttons.forEach((btn) => {
      if (btn.dataset.bound === "1") return;
      btn.dataset.bound = "1";
      btn.addEventListener("click", async () => {
        const text = btn.dataset.ucCopy ?? "";
        const labelSpan = btn.querySelector<HTMLElement>(".uc-copy-text");
        const def = btn.dataset.labelDefault ?? "Copy";
        const done = btn.dataset.labelCopied ?? "Copied";
        try {
          await navigator.clipboard.writeText(text);
          btn.classList.add("is-copied");
          if (labelSpan) labelSpan.textContent = done;
          window.setTimeout(() => {
            btn.classList.remove("is-copied");
            if (labelSpan) labelSpan.textContent = def;
          }, 1600);
        } catch {
          // Clipboard permission fallback
        }
      });
    });
  }

  bindTutorialCopyButtons();
  document.addEventListener("astro:page-load", bindTutorialCopyButtons);
</script>

<style>
  .uc-tstep {
    padding: 2.1rem 0 2.25rem;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
  }

  .uc-tstep:first-of-type {
    margin-top: 1.5rem;
  }

  .uc-tstep-head {
    display: flex;
    align-items: baseline;
    gap: 0.85rem;
    margin-bottom: 0.6rem;
  }

  .uc-tstep-num {
    flex-shrink: 0;
    font-family: var(--uc-font-mono);
    font-size: 0.92em;
    font-weight: 500;
    font-variant-numeric: tabular-nums;
    color: #e5a03d;
    letter-spacing: 0.02em;
  }

  .uc-tstep-title {
    margin: 0 !important;
    padding: 0 !important;
    border: none !important;
    font-size: 1.18em !important;
    font-weight: 500 !important;
    line-height: 1.35 !important;
    letter-spacing: -0.02em;
    color: #ffffff !important;
  }

  .uc-tstep-body :global(p) {
    margin-top: 0.55rem;
    margin-bottom: 0.85rem;
    font-size: 1em;
    line-height: 1.7;
    color: #cfcfcf;
  }

  .uc-tstep-prompt-wrap {
    margin-top: 1.15rem;
  }

  .uc-tstep-prompt-label {
    margin: 0 0 0.45rem;
    font-size: 0.92em;
    color: #8a8a8a;
  }

  .uc-tstep-prompt-box {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.85rem 1rem;
    border-radius: 7px;
    border: 1px solid rgba(255, 255, 255, 0.1);
    background: #0a0a0a;
  }

  .uc-tstep-prompt-text {
    font-size: 0.98em;
    line-height: 1.55;
    color: #f2f2f2;
    word-break: break-word;
  }

  .uc-tstep-prompt-text.is-mono {
    font-family: var(--uc-font-mono);
    font-size: 0.93em;
  }

  .uc-tstep-copy-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    flex-shrink: 0;
    padding: 0.38rem 0.72rem;
    border-radius: 5px;
    border: 1px solid rgba(255, 255, 255, 0.14);
    background: #141414;
    color: #e5e5e5;
    font-family: var(--uc-font-sans);
    font-size: 0.86em;
    font-weight: 500;
    cursor: pointer;
    transition: background 140ms ease, border-color 140ms ease, color 140ms ease;
  }

  .uc-tstep-copy-btn:hover {
    background: #ffffff;
    border-color: #ffffff;
    color: #000000;
  }

  .uc-tstep-copy-btn:focus-visible {
    outline: 2px solid #bae6fd;
    outline-offset: 2px;
  }

  .uc-tstep-copy-btn.is-copied {
    border-color: #bae6fd;
    color: #bae6fd;
    background: rgba(186, 230, 253, 0.08);
  }

  .uc-tstep-expect {
    display: flex;
    align-items: flex-start;
    gap: 0.55rem;
    margin-top: 0.95rem;
    padding-top: 0.75rem;
    border-top: 1px solid rgba(255, 255, 255, 0.05);
  }

  .uc-expect-icon {
    flex-shrink: 0;
    margin-top: 0.24rem;
  }

  .uc-expect-copy {
    margin: 0;
    font-size: 0.94em;
    line-height: 1.65;
    color: #b8b8b8;
  }

  .uc-expect-copy strong {
    color: #bae6fd;
    font-weight: 500;
  }

  @media (max-width: 600px) {
    .uc-tstep-prompt-box {
      flex-direction: column;
      align-items: stretch;
      gap: 0.65rem;
    }

    .uc-tstep-copy-btn {
      align-self: flex-end;
    }
  }
</style>
