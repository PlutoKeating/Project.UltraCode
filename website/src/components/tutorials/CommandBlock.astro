---
export interface Props {
  command: string;
  title?: string;
  label?: string;
  mono?: boolean;
  copyLabel?: string;
  copiedLabel?: string;
}

const {
  command,
  title,
  label,
  mono = true,
  copyLabel = "Copy",
  copiedLabel = "Copied",
} = Astro.props;
---

<div class="uc-cmd not-content">
  {label && <p class="uc-cmd-label">{label}</p>}
  <div class="uc-cmd-frame">
    {
      title && (
        <div class="uc-cmd-head">
          <span class="uc-cmd-title">{title}</span>
        </div>
      )
    }
    <div class="uc-cmd-body" dir={mono ? "ltr" : undefined}>
      <code class:list={["uc-cmd-text", { "is-mono": mono }]}>{command}</code>
      <button
        type="button"
        class="uc-cmd-copy"
        data-uc-copy={command}
        data-label-default={copyLabel}
        data-label-copied={copiedLabel}
      >
        <svg width="12" height="12" viewBox="0 0 16 16" fill="none" aria-hidden="true">
          <rect x="5.5" y="5.5" width="8" height="8" rx="1.5" stroke="currentColor" stroke-width="1.3" />
          <path
            d="M3.5 10.5H3a1.5 1.5 0 0 1-1.5-1.5V3A1.5 1.5 0 0 1 3 1.5h6A1.5 1.5 0 0 1 10.5 3v.5"
            stroke="currentColor"
            stroke-width="1.3"
          />
        </svg>
        <span class="uc-copy-text">{copyLabel}</span>
      </button>
    </div>
  </div>
</div>

<script>
  function bindCommandCopyButtons() {
    document.querySelectorAll<HTMLButtonElement>("button[data-uc-copy]").forEach((btn) => {
      if (btn.dataset.bound === "1") return;
      btn.dataset.bound = "1";
      btn.addEventListener("click", async () => {
        const text = btn.dataset.ucCopy ?? "";
        const label = btn.querySelector<HTMLElement>(".uc-copy-text");
        const def = btn.dataset.labelDefault ?? "Copy";
        const done = btn.dataset.labelCopied ?? "Copied";
        try {
          await navigator.clipboard.writeText(text);
          btn.classList.add("is-copied");
          if (label) label.textContent = done;
          window.setTimeout(() => {
            btn.classList.remove("is-copied");
            if (label) label.textContent = def;
          }, 1600);
        } catch {
          // Clipboard permission fallback
        }
      });
    });
  }

  bindCommandCopyButtons();
  document.addEventListener("astro:page-load", bindCommandCopyButtons);
</script>

<style>
  .uc-cmd {
    margin: 1.25rem 0 0.15rem;
  }

  .uc-cmd + .uc-cmd {
    margin-top: 0.55rem;
  }

  .uc-cmd-label {
    margin: 0 0 0.5rem;
    font-size: 0.92em;
    line-height: 1.5;
    color: #8a8a8a;
  }

  .uc-cmd-frame {
    border: 1px solid rgba(255, 255, 255, 0.09);
    border-radius: 6px;
    background: #0a0a0a;
    overflow: hidden;
  }

  .uc-cmd-head {
    padding: 0.42rem 0.85rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.07);
    font-family: var(--uc-font-mono);
    font-size: 0.8rem;
    line-height: 1.5;
    color: #a3a3a3;
  }

  .uc-cmd-body {
    display: flex;
    align-items: flex-start;
    gap: 0.9rem;
    padding: 0.68rem 0.85rem;
  }

  .uc-cmd-text {
    flex: 1;
    min-width: 0;
    font-family: var(--uc-font-sans);
    font-size: 1rem;
    line-height: 1.65;
    color: #d6deeb;
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }

  .uc-cmd-text.is-mono {
    font-family: var(--uc-font-mono);
    font-size: 0.9rem;
  }

  .uc-cmd-copy {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    flex-shrink: 0;
    margin-top: 0.05rem;
    padding: 0.22rem 0.5rem;
    border-radius: 4px;
    border: 1px solid rgba(255, 255, 255, 0.12);
    background: transparent;
    color: #a3a3a3;
    font-family: var(--uc-font-sans);
    font-size: 0.78rem;
    font-weight: 500;
    line-height: 1.4;
    cursor: pointer;
    transition: background 140ms ease, border-color 140ms ease, color 140ms ease;
  }

  .uc-cmd-copy:hover {
    background: #ffffff;
    border-color: #ffffff;
    color: #000000;
  }

  .uc-cmd-copy:focus-visible {
    outline: 1.5px solid #ffffff;
    outline-offset: 2px;
  }

  .uc-cmd-copy.is-copied {
    border-color: #bae6fd;
    color: #bae6fd;
  }

  .uc-cmd-copy svg {
    width: 0.85em;
    height: 0.85em;
  }

  @media (max-width: 600px) {
    .uc-cmd-body {
      gap: 0.5rem;
      padding: 0.6rem 0.7rem;
    }

    .uc-cmd-text {
      font-size: 0.88rem;
    }

    .uc-cmd-text.is-mono {
      font-size: 0.82rem;
    }

    .uc-cmd-copy {
      padding: 0.34rem 0.6rem;
      font-size: 0.82rem;
    }
  }
</style>
