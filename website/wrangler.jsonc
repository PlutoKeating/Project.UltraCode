{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "project-ultracode",
  "compatibility_date": "2026-11-21",
  "workers_dev": false,
  "routes": [
    {
      "pattern": "ultracode.plutokeating.beer",
      "custom_domain": true
    }
